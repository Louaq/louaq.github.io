---
import Footer from "@components/layout/Footer.astro";
import LeftSideBar from "@components/layout/LeftSideBar.astro";
import Navbar from "@components/layout/Navbar.astro";
import type { MarkdownHeading } from "astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import IconifyLoader from "@/components/misc/IconifyLoader.astro";
import { siteConfig } from "@/config";
import { isHomePage } from "@/utils/layout-utils";
import { getResponsiveSidebarConfig } from "@/utils/responsive-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	hideSidebar?: boolean;
	wideContent?: boolean;
}

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	headings = [],
	hideSidebar = false,
	wideContent = false,
} = Astro.props;

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);
const isPostPageCheck = postSlug !== undefined;

const isSingleColumnLayout = isPostPageCheck || hideSidebar;
const PostPageTOC = isPostPageCheck
	? (await import("@components/layout/PostPageTOC.astro")).default
	: null;


const sidebarConfig = getResponsiveSidebarConfig();

const gridCols = isSingleColumnLayout
	? "grid-cols-1"
	: "grid-cols-1 md:grid-cols-[17rem_1fr]";

const mainPanelTop = "5.5rem";
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} whiteBackground={hideSidebar}>


<!-- 全局图标加载器 -->
<IconifyLoader />


<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none fixed top-0 left-0 right-0 transition-[opacity,transform] duration-700">
    <div id="navbar-wrapper" class="pointer-events-auto transition-[opacity,transform] duration-700">
        <Navbar></Navbar>
    </div>
</div>


<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none no-banner-layout" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid" class={`w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!sidebarConfig.mobileShowSidebar ? 'mobile-no-sidebar' : ''}`}
        >

            <div id="left-sidebar-wrapper" class="contents">
                {!isSingleColumnLayout && (
                    <div class="hidden md:block md:row-start-1 md:row-end-2 md:col-start-1 md:col-end-2 md:h-full transition-main">
                        {/* 此处不能挂 onload-animation：它的 animation ... forwards 填充会把
                           opacity 永久钉在 1，且动画声明在级联中压过一切普通规则，
                           transition-main 的 is-animating 淡出会被它完全屏蔽 */}
                        <LeftSideBar headings={headings} class="md:h-full" />
                    </div>
                )}
            </div>

            {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
            <main id="swup-container" class:list={[
                "transition-swup-fade overflow-hidden w-full transition-main",
                isPostPageCheck
                    ? "max-w-[calc(var(--page-width)-18rem)] mx-auto"
                    : isSingleColumnLayout
                    ? wideContent
                        ? "max-w-none mx-auto"
                        : "max-w-[calc(var(--page-width)-18rem)] mx-auto"
                    : "md:col-start-2 md:col-end-3",
            ]}>
                {/* 携带网格布局类名，用于JS更新父容器 */}
                <div id="grid-class-carrier" data-grid-class={gridCols} data-white-bg={String(hideSidebar)} class="hidden"></div>
                {/* 备用 h1 标题 - 当主页横幅文本未启用时，提供隐藏的主标题 */}
                {isHomePageCheck && (
                        <h1 class="sr-only">{siteConfig.title}</h1>
                )}
                <div id="content-wrapper" class="onload-animation transition-leaving">
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            {/* 占位容器：保留 swup container 不变 */}
            <div id="right-sidebar-static" class="hidden"></div>
            <div id="right-sidebar-dynamic" class="hidden"></div>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

    </div>
</div>

{/* fuwari 风格的悬浮目录 - 文章页且足够宽屏时显示在主内容区右侧外部
   注意：所有页面都必须渲染 #post-toc-floating-layer 容器，因为它已注册为 swup container；
   非文章页渲染为空占位即可。 */}
<div
    id="post-toc-floating-layer"
    class:list={[
        "absolute w-full z-30 pointer-events-none post-toc-floating-layer",
        { "is-post-page": isPostPageCheck },
    ]}
    style={`top: ${mainPanelTop}`}
>
    {isPostPageCheck && (
        <div class="relative max-w-(--page-width) mx-auto px-2 md:px-4">
            <div class="post-toc-wrapper absolute top-0" style="left: calc(50% + 29.5rem); width: min(20rem, calc(50vw - 30.5rem));">
                <div class="post-toc-inner-wrapper fixed top-22 max-h-[calc(100vh-7rem)] pointer-events-auto pr-2 pb-4 overflow-y-auto overflow-x-hidden hide-scrollbar" style="width: min(20rem, calc(50vw - 30.5rem));">
                    {PostPageTOC && <PostPageTOC headings={headings} />}
                </div>
            </div>
        </div>
    )}
</div>

<FloatingControls headings={headings} showToc={isPostPageCheck} />


</Layout>

<style is:global>

  :root:not(.dark):has(body[data-page-type="post"]) {
    background-color: #f9f9f9 !important;
  }
  :root:not(.dark) body[data-page-type="post"] {
    background-color: #f9f9f9 !important;
  }

  body[data-white-bg="true"]::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    /* 中心实、四周渐隐；单层 radial 遮罩即可，无需 mask-composite，兼容性更稳 */
    -webkit-mask-image: radial-gradient(ellipse 88% 78% at 50% 45%, #000 45%, transparent 100%);
    mask-image: radial-gradient(ellipse 88% 78% at 50% 45%, #000 45%, transparent 100%);
  }

  :root:not(.dark):has(body[data-white-bg="true"]) {
    background-color: #f9f9f9 !important;
  }
  body[data-white-bg="true"] {
    background-color: transparent !important;
  }

  /* 右侧栏平滑过渡 */
  #right-sidebar {
    transition: opacity 0.35s ease-in-out, 
                transform 0.35s ease-in-out;
  }

  .post-toc-floating-layer {
    display: none;
  }

  .post-toc-floating-layer .toc-item {
    align-items: flex-start;
  }

  .post-toc-floating-layer .toc-label {
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  @media (min-width: 1400px) {
    .post-toc-floating-layer.is-post-page {
      display: block;
    }
  }

  /* `.hide-scrollbar` 不在这里重复定义：main.css 已有 `@utility hide-scrollbar`
     且声明完全相同，本文件上方的 .post-toc-inner-wrapper 直接用那个工具类即可。 */
</style>

