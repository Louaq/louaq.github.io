---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import Layout from "@/layouts/Layout.astro";
import { url } from "@/utils/url-utils";
---

<Layout
	title={i18n(I18nKey.notFound)}
	description={i18n(I18nKey.notFoundDescription)}
	whiteBackground
>
	<main data-no-swup class="min-h-screen flex items-center justify-center px-6 py-12">
		<div class="flex flex-col md:flex-row items-center gap-10 md:gap-16 max-w-4xl">
			<img
				src={url("/assets/images/404-ufo.svg")}
				alt=""
				width="672"
				height="738"
				class="ufo-art w-52 md:w-72 shrink-0 h-auto"
			/>

			<div class="text-center md:text-left">
				<p class="text-7xl md:text-8xl font-bold text-90 leading-none">
					{i18n(I18nKey.notFound)}
				</p>
				<h1 class="text-2xl md:text-3xl font-bold text-90 mt-4">
					{i18n(I18nKey.notFoundTitle)}
				</h1>
				<p class="text-75 mt-3">{i18n(I18nKey.notFoundDescription)}</p>
				<a
					href={url("/")}
					class="inline-block mt-7 px-6 py-2.5 bg-(--primary) text-white rounded-lg font-medium hover:opacity-80 transition-opacity duration-200"
				>
					{i18n(I18nKey.backToHome)}
				</a>
			</div>
		</div>
	</main>
</Layout>

<style>
	:global(html.dark) .ufo-art {
		filter: invert(1) hue-rotate(180deg);
	}
</style>
