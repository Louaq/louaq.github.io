---
import ClientPagination from "@/components/common/ClientPagination.astro";
import Icon from "@/components/common/Icon.astro";
import TabNav from "@/components/common/TabNav.astro";
import { siteConfig } from "@/config";
import { type WatchlistItem, watchlistConfig } from "@/config/watchlistConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.watchlist) {
	return Astro.redirect("/404/");
}

// 获取启用的观影项目
const enabledItems = watchlistConfig.items.filter((item) => item.enabled);

// 分页与排序均取自 watchlistConfig.display，改配置即生效
const { itemsPerPage, sortBy, sortOrder } = watchlistConfig.display;

// 取出参与比较的字段：date 用开始时间（缺失则退回完成时间）
const sortKey = (item: WatchlistItem): string | number => {
	switch (sortBy) {
		case "rating":
			return item.rating ?? 0;
		case "title":
			return item.title;
		default:
			return item.startDate || item.endDate || "";
	}
};

// 置顶项恒在最前，不受 sortBy / sortOrder 影响
const compareItems = (a: WatchlistItem, b: WatchlistItem) => {
	if (!!a.pinned !== !!b.pinned) {
		return a.pinned ? -1 : 1;
	}
	const keyA = sortKey(a);
	const keyB = sortKey(b);
	const diff =
		typeof keyA === "number" && typeof keyB === "number"
			? keyA - keyB
			: String(keyA).localeCompare(String(keyB));
	return sortOrder === "asc" ? diff : -diff;
};

// 按类型分类并排序
const categorizedItems = {
	anime: enabledItems
		.filter((item) => item.type === "anime")
		.sort(compareItems),
	movie: enabledItems
		.filter((item) => item.type === "movie")
		.sort(compareItems),
	tv: enabledItems.filter((item) => item.type === "tv").sort(compareItems),
	documentary: enabledItems
		.filter((item) => item.type === "documentary")
		.sort(compareItems),
	other: enabledItems
		.filter((item) => item.type === "other")
		.sort(compareItems),
};

// 分类配置（按照指定顺序）
const categories = [
	{
		key: "anime",
		name: i18n(I18nKey.watchlistCategoryAnime),
		icon: "material-symbols:movie",
		items: categorizedItems.anime,
	},
	{
		key: "movie",
		name: i18n(I18nKey.watchlistCategoryMovie),
		icon: "material-symbols:theaters",
		items: categorizedItems.movie,
	},
	{
		key: "tv",
		name: i18n(I18nKey.watchlistCategoryTV),
		icon: "material-symbols:tv",
		items: categorizedItems.tv,
	},
	{
		key: "documentary",
		name: i18n(I18nKey.watchlistCategoryDocumentary),
		icon: "material-symbols:documentary",
		items: categorizedItems.documentary,
	},
	{
		key: "other",
		name: i18n(I18nKey.watchlistCategoryOther),
		icon: "material-symbols:category",
		items: categorizedItems.other,
	},
].filter((category) => category.items.length > 0); // 只显示有内容的分类

// 准备标签页数据
const tabs = categories.map((category) => ({
	id: category.key,
	name: category.name,
	count: category.items.length,
}));

const activeTab = tabs[0]?.id || "anime";

// 根据 URL hash 在首屏绘制前修正栏目（内联 CSS + script），避免先闪默认 tab 再跳转
const watchlistTabIds = tabs.map((t) => t.id);
const watchlistTabIdsJson = JSON.stringify(watchlistTabIds);
const watchlistRestoreCss =
	watchlistTabIds.length > 0
		? watchlistTabIds
				.map(
					(id) => `
html[data-watchlist-restore="${id}"] .watchlist-tabs-root .category-section:not([data-section="${id}"]) {
	display: none !important;
}
html[data-watchlist-restore="${id}"] .watchlist-tabs-root .category-section[data-section="${id}"] {
	display: block !important;
}
html[data-watchlist-restore="${id}"] .watchlist-tabs-root nav button[data-tab="${id}"] {
	border-bottom-color: var(--primary);
	color: var(--primary);
}
html[data-watchlist-restore="${id}"] .watchlist-tabs-root nav button[data-tab]:not([data-tab="${id}"]) {
	border-bottom-color: transparent;
	color: rgb(107 114 128);
}
html.dark[data-watchlist-restore="${id}"] .watchlist-tabs-root nav button[data-tab]:not([data-tab="${id}"]) {
	color: rgb(156 163 175);
}
`,
				)
				.join("\n")
		: "";

// 生成稳定的锚点 id，供全站搜索跳转定位
const makeWatchAnchorId = (item: WatchlistItem) => {
	const raw = `${item.type} ${item.title}`.trim();
	const base = encodeURIComponent(raw).replace(/%/g, "").replace(/[()]/g, "");
	const short = base.length > 80 ? base.slice(0, 80) : base;
	return `watch-${short}` || "watch";
};

// 状态文本映射
const statusText = {
	watching: "在看",
	completed: "已看",
	plan_to_watch: "想看",
};

// 状态颜色映射
const statusColor = {
	watching: "text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20",
	completed:
		"text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/20",
	plan_to_watch:
		"text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-900/20",
};
---

<MainGridLayout
	title={i18n(I18nKey.watchlistTitle)}
	description={i18n(I18nKey.watchlistSubtitle)}
	hideSidebar
	wideContent
>
	<div class="watchlist-page">
		<div class="watchlist-shell">
			<div class="relative w-full mb-8">

			<!-- Tab 导航和内容 -->
			{
				tabs.length > 0 ? (
					<>
						{watchlistRestoreCss ? (
							<style is:inline set:html={watchlistRestoreCss} />
						) : null}
						<script is:inline define:vars={{ watchlistTabIdsJson }}>
							(function () {
								// watchlistTabIdsJson 由构建期序列化，必然是合法 JSON
								var ids = JSON.parse(watchlistTabIdsJson);
								var h = location.hash
									? location.hash.slice(1).replace(/^\/+|\/+$/g, "")
									: "";
								if (h && ids.indexOf(h) !== -1) {
									document.documentElement.setAttribute(
										"data-watchlist-restore",
										h,
									);
								}
							})();
						</script>
						<div class="watchlist-tabs-root">
						<TabNav
							tabs={tabs}
							activeTab={activeTab}
							syncHash
							restoreAttr="data-watchlist-restore"
						/>

						<!-- 内容区域 -->
						{categories.map((category) => (

							<div
								class:list={["category-section", { hidden: category.key !== activeTab }]}
								data-section={category.key}
							>
								{/* 分类内容网格容器 */}
								<div class="pagination-container" data-container-section={category.key}>
									<div class="watchlist-grid">
										{category.items.map((item: WatchlistItem, itemIndex: number) => (
										<article
											class="watchlist-card"
											id={makeWatchAnchorId(item)}
											data-item-section={category.key}>
											{/* 封面图 */}
											<div class="watchlist-poster">
												<img
													src={item.cover}
													alt={item.title}
													width="360"
													height="540"
													class="watchlist-poster-image"
													loading={category.key === activeTab && itemIndex === 0 ? "eager" : "lazy"}
													fetchpriority={category.key === activeTab && itemIndex === 0 ? "high" : "low"}
													decoding="async"
												/>
												{watchlistConfig.display.showRating &&
													typeof item.rating === "number" &&
													item.rating > 0 && (
														<div class="watchlist-rating" aria-label={`评分 ${item.rating}`}>
															<Icon icon="material-symbols:star-rounded" class="text-base text-yellow-400" />
															<span>{item.rating}</span>
														</div>
													)}
												{/* 状态标签 */}
												<div class="watchlist-status">
													<span
														class={`inline-flex items-center px-2 py-1 text-xs font-medium rounded-md shadow-sm ${statusColor[item.status]}`}
													>
														{statusText[item.status]}
													</span>
												</div>
											</div>

											<div class="watchlist-card-info">
												{/* 标题 */}
												<h3 class="watchlist-title line-clamp-2" title={item.title}>
													{item.title}
												</h3>

												{/* 观看进度（动漫、电视剧不显示） */}
												{watchlistConfig.display.showProgress &&
													item.type !== "anime" &&
													item.type !== "tv" &&
													item.episodes &&
													item.episodes.total && (
														<div class="watchlist-progress">
															<div class="flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400 mb-1">
																<span>观看进度</span>
																<span>
																	{item.episodes.current || 0}/{item.episodes.total}
																</span>
															</div>
															<div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-1.5">
																<div
																	class="bg-(--primary) h-1.5 rounded-full"
																	style={{
																		width: `${((item.episodes.current || 0) / item.episodes.total) * 100}%`,
																	}}
																/>
															</div>
														</div>
													)}

												{/* 标签 */}
												{item.tags && item.tags.length > 0 && (
													<p class="watchlist-tags line-clamp-2">
														{item.tags.slice(0, 3).join(" · ")}
													</p>
												)}

											</div>
										</article>
									))}
								</div>

								{/* 分页控件 */}
								<ClientPagination
									totalItems={category.items.length}
									itemsPerPage={itemsPerPage}
									currentPage={1}
									sectionId={category.key}
								/>
								</div>
							</div>
						))}
						</div>
					</>
				) : (
					<div class="text-center py-16">
						<div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
							<Icon
								icon="material-symbols:video-library"
								class="text-[2rem] text-(--btn-content)"
							/>
						</div>
						<h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
							{i18n(I18nKey.watchlistEmpty)}
						</h2>
						<p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
							{i18n(I18nKey.watchlistEmptyReason)}
						</p>
					</div>
				)
			}
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	.watchlist-page {
		width: 100%;
	}

	.watchlist-shell {
		padding: 0 0 1rem;
	}

	.watchlist-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
		gap: 1.25rem clamp(1rem, 1.6vw, 1.75rem);
	}

	.watchlist-card {
		min-width: 0;
		max-width: 15rem;
		color: var(--juejin-text-primary);
	}

	.watchlist-poster {
		position: relative;
		aspect-ratio: 2 / 3;
		overflow: hidden;
		border: 1px solid color-mix(in oklch, var(--juejin-border) 82%, transparent);
		border-radius: 0.55rem;
		background: var(--juejin-tag-bg);
		box-shadow: 0 7px 20px rgba(15, 23, 42, 0.1);
	}

	:global(.dark) .watchlist-poster {
		box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
	}

	.watchlist-poster-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	.watchlist-status {
		position: absolute;
		top: 0.55rem;
		left: 0.55rem;
	}

	.watchlist-card-info {
		padding: 0.75rem 0.15rem 0;
	}

	.watchlist-title {
		min-height: 2.7em;
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: 0.01em;
	}

	.watchlist-rating {
		position: absolute;
		top: 0.55rem;
		right: 0.55rem;
		display: flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.25rem 0.5rem;
		border-radius: 0.45rem;
		background: rgba(17, 24, 39, 0.78);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
		backdrop-filter: blur(6px);
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1;
		color: white;
	}

	.watchlist-tags {
		min-height: 2.8em;
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
		line-height: 1.4;
		color: var(--juejin-text-tertiary);
	}

	.watchlist-progress {
		margin-top: 0.55rem;
	}

	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 640px) {
		.watchlist-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1rem 0.85rem;
		}

		.watchlist-card {
			max-width: none;
		}

		.watchlist-card-info {
			padding-top: 0.6rem;
		}

		.watchlist-title {
			font-size: 0.875rem;
		}
	}
</style>

