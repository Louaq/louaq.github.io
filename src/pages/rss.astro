---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlForEntry } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const posts = await getSortedPosts();
const recentPosts = posts.slice(0, 6);
---

<MainGridLayout title={i18n(I18nKey.rss)} description={i18n(I18nKey.rssDescription)} hideSidebar wideContent>

    <div class="card-base card-plain px-6 md:px-9 pt-6 pb-4 onload-animation">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-4">
            <div class="w-14 h-14 bg-(--primary) rounded-2xl flex items-center justify-center shrink-0">
                <Icon name="material-symbols:rss-feed" class="text-white text-3xl" />
            </div>
            <div class="mr-auto min-w-0">
                <h1 class="text-2xl md:text-3xl font-bold text-(--primary)">{i18n(I18nKey.rss)}</h1>
                <p class="text-75 text-sm mt-1">{i18n(I18nKey.rssSubtitle)}</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <code
                    aria-label={i18n(I18nKey.rssLink)}
                    class="bg-(--card-bg) px-3 py-2 rounded-lg text-sm font-mono text-75 border border-(--line-divider) break-all"
                >
                    {Astro.site}rss.xml
                </code>
                <button
                    id="copy-rss-btn"
                    class="px-4 py-2 bg-(--primary) text-white rounded-lg hover:opacity-80 transition-opacity duration-200 font-medium text-sm whitespace-nowrap"
                    data-url={`${Astro.site}rss.xml`}
                >
                    {i18n(I18nKey.rssCopyLink)}
                </button>
            </div>
        </div>

        <div class="border-(--line-divider) border-dashed border-b my-6"></div>
        <div class="grid gap-x-9 gap-y-6 items-start lg:grid-cols-[minmax(0,1fr)_18rem]">
            <section>
                <h2 class="text-xl font-bold text-90 mb-4 flex items-center gap-2">
                    <Icon name="material-symbols:article" class="text-(--primary)" />
                    {i18n(I18nKey.rssLatestPosts)}
                </h2>
                {recentPosts.map((post) => (
                    <a
                        href={getPostUrlForEntry(post)}
                        class="group block rounded-xl px-4 py-3 -mx-4 transition-colors duration-200"
                    >
                        <h3 class="font-semibold text-90 group-hover:text-(--primary) transition-colors duration-200">
                            {post.data.title}
                        </h3>
                        {post.data.description && (
                            <p class="text-75 text-sm mt-1 line-clamp-1">{post.data.description}</p>
                        )}
                        <time datetime={post.data.published.toISOString()} class="text-xs text-50">
                            {formatDateToYYYYMMDD(post.data.published)}
                        </time>
                    </a>
                ))}
            </section>

            <section class="text-75 text-sm lg:sticky lg:top-4 lg:pl-9 lg:border-l lg:border-dashed lg:border-(--line-divider)">
                <h2 class="text-lg font-bold text-90 mb-3 flex items-center gap-2">
                    <Icon name="material-symbols:help-outline" class="text-(--primary)" />
                    {i18n(I18nKey.rssWhatIsRSS)}
                </h2>
                <p class="mb-3">{i18n(I18nKey.rssWhatIsRSSDescription)}</p>
                <ul class="list-disc list-outside space-y-1 pl-5 mb-3">
                    <li>{i18n(I18nKey.rssBenefit1)}</li>
                    <li>{i18n(I18nKey.rssBenefit2)}</li>
                    <li>{i18n(I18nKey.rssBenefit3)}</li>
                    <li>{i18n(I18nKey.rssBenefit4)}</li>
                </ul>
                <p class="text-xs">{i18n(I18nKey.rssHowToUse)}</p>
            </section>
        </div>
    </div>

    <script>
        function initRssCopy() {
            const newBtn = document.getElementById('copy-rss-btn');
            if (!newBtn) return;
            if (newBtn.dataset.rssCopyBound === 'true') return;
            newBtn.dataset.rssCopyBound = 'true';

            newBtn.addEventListener('click', async () => {
                try {
                    // data-url 由服务端渲染写死，必然存在
                    await navigator.clipboard.writeText(newBtn.dataset.url!);
                } catch (err) {
                    console.error('复制失败:', err);
                }
            });
        }

        initRssCopy();
        document.addEventListener('astro:page-load', initRssCopy);
    </script>
</MainGridLayout>