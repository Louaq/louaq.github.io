---
import { render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import License from "@components/misc/License.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
	getResolvedPostPath,
	getTagUrl,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import PostStaleNoticeBanner from "@/components/layout/PostStaleNoticeBanner.astro";
import EncryptedContent from "@/components/misc/EncryptedContent.astro";
import PasswordProtection from "@/components/misc/PasswordProtection.svelte";
import PromoStrip from "@/components/misc/PromoStrip.astro";
import { commentConfig } from "@/config";
import { coverImageConfig } from "@/config/coverImageConfig";
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { sponsorConfig } from "@/config/sponsorConfig";
import { getCategoryUrl } from "@/utils/category-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	const seen = new Map<string, string>();
	for (const entry of blogEntries) {
		const segment = getResolvedPostPath(entry.id, entry.data);
		const dup = seen.get(segment);
		if (dup !== undefined) {
			throw new Error(
				`文章路径冲突：「${segment}」同时对应 ${dup} 与 ${entry.id}`,
			);
		}
		seen.set(segment, entry.id);
	}
	return blogEntries.map((entry) => {
		const slug = getResolvedPostPath(entry.id, entry.data);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const processedImage = entry.data.image;

const lastModified = new Date(entry.data.updated || entry.data.published);
const daysDiff = Math.floor((Date.now() - lastModified.getTime()) / 86400000);
const outdatedThreshold = siteConfig.outdatedThreshold ?? 1;
const shouldShowOutdatedNotice =
	siteConfig.showLastModified && daysDiff >= outdatedThreshold;
// sv-SE 的本地化日期格式恰好就是 YYYY-MM-DD，且走构建机本地时区
const lastModifiedDateStr = lastModified.toLocaleDateString("sv-SE");
const lastModifiedMain = `${i18n(I18nKey.lastModifiedPrefix)}${lastModifiedDateStr}${
	daysDiff >= 1
		? `，${i18n(I18nKey.lastModifiedDaysAgo).replace("{days}", daysDiff.toString())}`
		: ""
}`;
const staleNoticeBody = `${lastModifiedMain}${i18n(I18nKey.lastModifiedNoticeJoiner)}${i18n(I18nKey.lastModifiedOutdated)}`;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---

<MainGridLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={getResolvedPostPath(entry.id, entry.data)}
  headings={headings}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <div
    class="flex w-full relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      {/* 顶部推广位（由 config/adConfig.ts 控制，未启用时不渲染） */}
      <PromoStrip placement="top" class="onload-animation" />

      <!-- 顶部元信息卡：有封面时以封面为底，否则用主题色渐变；集中展示分类、标签、标题、统计与日期 -->
      <div class:list={["post-meta-hero mb-6 onload-animation", { "has-cover": processedImage }]}>
        {processedImage && (
          <CoverImage
            src={processedImage}
            basePath={getFileDirFromPath(entry.filePath || '')}
            class="absolute inset-0"
            preview={false}
          />
        )}
        <div class="post-meta-hero-inner">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <a href={getCategoryUrl(entry.data.category || "")} class="post-meta-badge">
              {entry.data.category || i18n(I18nKey.uncategorized)}
            </a>
            {entry.data.tags.map((tag) => (
              <a href={getTagUrl(tag)} class="post-meta-tag"># {tag.trim()}</a>
            ))}
          </div>

          <h1 class="text-3xl md:text-[2.5rem]/[3rem] font-bold wrap-break-word">
            {entry.data.title}
            {entry.data.password && (
              <Icon name="material-symbols:lock-outline" class="inline align-middle ml-2" aria-label="文章已加密" />
            )}
          </h1>

          <div class="post-meta-items">
            <span><Icon name="material-symbols:notes-rounded" />{remarkPluginFrontmatter.words} {i18n(I18nKey.wordsCount)}</span>
            <span>
              <Icon name="material-symbols:schedule-outline-rounded" />
              {remarkPluginFrontmatter.minutes}
              {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
            </span>
            <span aria-label={i18n(I18nKey.publishedAt)}>
              <Icon name="material-symbols:calendar-today-outline-rounded" />{formatDateToYYYYMMDD(entry.data.published)}
            </span>
            {siteConfig.showLastModified && entry.data.updated && entry.data.updated.getTime() !== entry.data.published.getTime() && (
              <span aria-label={i18n(I18nKey.lastModifiedPrefix)}>
                <Icon name="material-symbols:edit-calendar-outline-rounded" />{formatDateToYYYYMMDD(entry.data.updated)}
              </span>
            )}
            {commentConfig.type === "twikoo" && commentConfig.twikoo?.visitorCount && (
              <span aria-label={i18n(I18nKey.pageViews)}>
                <Icon name="material-symbols:visibility-outline-rounded" />
                <span id="twikoo_visitors">{i18n(I18nKey.pageViewsLoading)}</span>
              </span>
            )}
          </div>
        </div>
      </div>

      <!-- 过期/过时提醒：置于正文前（非加密文章直接显示；加密文章移至解锁后显示） -->
      {!entry.data.password && shouldShowOutdatedNotice && (
        <PostStaleNoticeBanner
          title={i18n(I18nKey.lastModifiedNoticeTitle)}
          body={staleNoticeBody}
        />
      )}

      <!-- always show cover as long as it has one -->

      {
        processedImage && coverImageConfig.enableInPost && (
          <div style="margin-top:1rem;">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || '')}
              class="mb-8 rounded-xl banner-container onload-animation"
              preview={false}
            />
          </div>
        )
      }

      {/* 密码保护：正文在构建期加密，页面源码中不含明文密码与明文正文 */}
      {entry.data.password ? (
        <div id="password-protection-wrapper">
          <PasswordProtection
            client:idle
            postId={entry.id}
            hint={siteConfig.postPasswordHint ?? ""}
          />
          <EncryptedContent
            password={typeof entry.data.password === 'boolean' ? (siteConfig.postPassword ?? "") : entry.data.password}
          >
            {/* 加密文章：过期提示仅解锁后显示 */}
            {shouldShowOutdatedNotice && (
              <PostStaleNoticeBanner
                title={i18n(I18nKey.lastModifiedNoticeTitle)}
                body={staleNoticeBody}
              />
            )}
            <Markdown class="mb-6 markdown-content onload-animation">
              <Content />
            </Markdown>
          </EncryptedContent>
        </div>
      ) : (
        <Markdown class="mb-6 markdown-content onload-animation">
          <Content />
        </Markdown>
      )}
      
      <script is:inline>
        // 监听密码解锁事件
        window.addEventListener('password-unlocked', function() {
          const wrapper = document.getElementById('password-protection-wrapper');
          const protectedContent = document.getElementById('protected-content');
          
          if (wrapper && protectedContent) {
            // 隐藏密码输入界面，显示文章内容
            const passwordCard = wrapper.querySelector('.password-protection-container');
            if (passwordCard) {
              passwordCard.style.display = 'none';
            }
            protectedContent.style.display = 'block';
            // 正文是解锁后才注入 DOM 的，需要重新触发依赖 astro:page-load 的
            // 初始化逻辑（表格滚动包裹、TOC、代码块复制按钮等）
            document.dispatchEvent(new Event('astro:page-load'));
          }
        });
      </script>

      {/* 赞助按钮 */}
      {
        sponsorConfig.showButtonInPost && siteConfig.pages.sponsor && (
          <div class="mb-6 rounded-xl onload-animation">
            <div class="p-6 bg-(--license-block-bg) rounded-xl">
              <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3 flex-1">
                  <div class="h-12 w-12 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
                    <Icon name="material-symbols:favorite" class="text-2xl" />
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
                      {i18n(I18nKey.sponsorButton)}
                    </h3>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">
                      {i18n(I18nKey.sponsorButtonText)}
                    </p>
                  </div>
                </div>
                <a
                  href={url("/sponsor/")}
                  class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/80 hover:scale-105 active:scale-95 transition-transform whitespace-nowrap"
                >
                  <span>{i18n(I18nKey.sponsor)}</span>
                  <Icon name="fa6-solid:arrow-right" class="text-sm" />
                </a>
              </div>
            </div>
          </div>
        )
      }

      {
        licenseConfig.enable && (
          <License
            title={entry.data.title}
            id={entry.id}
            pubDate={entry.data.published}
            author={entry.data.author}
            sourceLink={entry.data.sourceLink}
            licenseName={entry.data.licenseName}
            licenseUrl={entry.data.licenseUrl}
            class="mb-6 rounded-xl license-container onload-animation"
          />
        )
      }

      {/* 底部推广位（由 config/adConfig.ts 控制，未启用时不渲染） */}
      <PromoStrip placement="bottom" class="onload-animation" />
    </div>
  </div>

  {
    (siteConfig.showPostPrevNext ?? true) &&
      (entry.data.nextSlug || entry.data.prevSlug) && (
        <div class="post-nav flex flex-col md:flex-row justify-between mb-4 gap-4 w-full">
          <a
            href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
            class:list={[
              "post-nav-item active:scale-95",
              { "pointer-events-none": !entry.data.nextSlug },
            ]}
          >
            {
              entry.data.nextSlug && (
                <div class="post-nav-card">
                  <div class="post-nav-label">
                    <Icon
                      name="material-symbols:arrow-back-rounded"
                      class="text-[1.05rem]"
                    />
                    <span>上一篇</span>
                  </div>
                  <div class="post-nav-title">{entry.data.nextTitle}</div>
                </div>
              )
            }
          </a>

          <a
            href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
            class:list={[
              "post-nav-item active:scale-95",
              { "pointer-events-none": !entry.data.prevSlug },
            ]}
          >
            {
              entry.data.prevSlug && (
                <div class="post-nav-card post-nav-card--next">
                  <div class="post-nav-label">
                    <span>下一篇</span>
                    <Icon
                      name="material-symbols:arrow-forward-rounded"
                      class="text-[1.05rem]"
                    />
                  </div>
                  <div class="post-nav-title">{entry.data.prevTitle}</div>
                </div>
              )
            }
          </a>
        </div>
      )
  }

  <!-- 评论 -->
  {entry.data.comment && <Comment post={entry} />}
</MainGridLayout>

<style>
  /* 顶部元信息卡：与站内卡片同一套样式（卡片底色、细边框、浅阴影），主题色只做点缀；
     有封面时封面铺底、加暗色遮罩，文字改白 */
  .post-meta-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 0.75rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    color: rgba(0, 0, 0, 0.9);
    background:
      radial-gradient(50% 120% at 100% 0%, color-mix(in oklch, var(--primary) 12%, transparent), transparent),
      var(--card-bg);
  }

  :global(:root.dark) .post-meta-hero {
    border-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
  }

  .post-meta-hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    min-height: 14rem;
    padding: 1.5rem;
  }

  .post-meta-badge {
    padding: 0.2rem 0.6rem;
    border-radius: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--btn-content);
    background: var(--btn-regular-bg);
  }

  .post-meta-items,
  .post-meta-tag {
    color: #737373;
  }

  :global(:root.dark) .post-meta-items,
  :global(:root.dark) .post-meta-tag {
    color: #a3a3a3;
  }

  .post-meta-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.875rem;
  }

  .post-meta-items > span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .post-meta-tag {
    font-size: 0.8125rem;
  }

  .post-meta-tag:hover {
    color: var(--primary);
  }

  .has-cover .post-meta-hero-inner {
    background: rgba(0, 0, 0, 0.45);
  }

  .has-cover,
  .has-cover .post-meta-items,
  .has-cover .post-meta-tag {
    color: #fff;
  }

  .has-cover .post-meta-badge {
    color: #fff;
    background: rgba(255, 255, 255, 0.2);
  }

  @media (min-width: 768px) {
    .post-meta-hero-inner {
      padding: 2rem 2.5rem;
    }
  }

  /* 上一篇/下一篇：方向标签 + 标题的两行结构（参考 ThriveX-Blog 的文章导航）。
     不复用 .btn-card：main.css 里它被强制 border-radius:4px，且是全站按钮样式。 */
  .post-nav-item {
    width: 100%;
    min-width: 0;
  }

  .post-nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-large);
    background: var(--card-bg);
    border: 1px solid var(--juejin-border);
  }

  :root.dark .post-nav-card {
    border-color: rgba(255, 255, 255, 0.08);
  }

  /* 下一篇卡片整体右对齐，形成左右呼应 */
  .post-nav-card--next {
    align-items: flex-end;
  }

  .post-nav-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--juejin-text-tertiary);
  }

  .post-nav-title {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--primary);
  }

  .post-nav-card--next .post-nav-title {
    text-align: right;
  }
</style>
