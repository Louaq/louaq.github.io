---
import { render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import License from "@components/misc/License.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
	getResolvedPostPath,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import PostStaleNoticeBanner from "@/components/layout/PostStaleNoticeBanner.astro";
import EncryptedContent from "@/components/misc/EncryptedContent.astro";
import PasswordProtection from "@/components/misc/PasswordProtection.svelte";
import { coverImageConfig } from "@/config/coverImageConfig";
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { sponsorConfig } from "@/config/sponsorConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	const seen = new Map<string, string>();
	for (const entry of blogEntries) {
		const segment = getResolvedPostPath(entry.id, entry.data);
		const dup = seen.get(segment);
		if (dup !== undefined) {
			throw new Error(
				`文章路径冲突：「${segment}」同时对应 ${dup} 与 ${entry.id}`,
			);
		}
		seen.set(segment, entry.id);
	}
	return blogEntries.map((entry) => {
		const slug = getResolvedPostPath(entry.id, entry.data);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const processedImage = entry.data.image;

dayjs.extend(utc);

const lastModified = dayjs(entry.data.updated || entry.data.published);
const now = dayjs();
const daysDiff = now.diff(lastModified, "day");
const outdatedThreshold = siteConfig.outdatedThreshold ?? 1;
const shouldShowOutdatedNotice =
	siteConfig.showLastModified && daysDiff >= outdatedThreshold;
const lastModifiedDateStr = lastModified.format("YYYY-MM-DD");
const commaBeforeDays = siteConfig.lang.startsWith("zh")
	? "，"
	: siteConfig.lang === "ja"
		? "、"
		: ", ";
const lastModifiedMain = `${i18n(I18nKey.lastModifiedPrefix)}${lastModifiedDateStr}${
	daysDiff >= 1
		? `${commaBeforeDays}${i18n(I18nKey.lastModifiedDaysAgo).replace("{days}", daysDiff.toString())}`
		: ""
}`;
const staleNoticeBody = `${lastModifiedMain}${i18n(I18nKey.lastModifiedNoticeJoiner)}${i18n(I18nKey.lastModifiedOutdated)}`;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---

<MainGridLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={getResolvedPostPath(entry.id, entry.data)}
  headings={headings}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <div
    class="flex w-full relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      <!-- word count and reading time -->
      <div
        class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 onload-animation"
      >
        <div class="flex flex-row items-center">
          <div
            class="h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
          >
            <Icon name="material-symbols:notes-rounded" />
          </div>
          <div class="text-sm">
            {remarkPluginFrontmatter.words}
            {" " + i18n(I18nKey.wordsCount)}
          </div>
        </div>
        <div class="flex flex-row items-center">
          <div
            class="h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
          >
            <Icon name="material-symbols:schedule-outline-rounded" />
          </div>
          <div class="text-sm">
            {remarkPluginFrontmatter.minutes}
            {
              " " +
                i18n(
                  remarkPluginFrontmatter.minutes === 1
                    ? I18nKey.minuteCount
                    : I18nKey.minutesCount
                )
            }
          </div>
        </div>
      </div>

      <!-- title -->
      <div class="relative onload-animation">
        <h1
          class="w-full flex items-center gap-2 flex-wrap font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    wrap-break-word
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                    before:absolute before:top-3 before:-left-4.5"
        >
          <span class="min-w-0">{entry.data.title}</span>
          {entry.data.password && (
            <Icon
              name="material-symbols:lock-outline"
              class="inline text-2xl md:text-3xl align-middle -translate-y-px text-inherit shrink-0"
              aria-label="文章已加密"
            />
          )}
        </h1>
      </div>

      <!-- metadata -->
      <div class="onload-animation">
        <PostMetadata
          className="mb-5"
          published={entry.data.published}
          updated={entry.data.updated}
          tags={entry.data.tags}
          category={entry.data.category || undefined}
          id={entry.id}
          hideUpdateDate={!siteConfig.showLastModified}
        />
        {
          !processedImage && (
            <div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
          )
        }
      </div>

      <!-- 过期/过时提醒：置于正文前（非加密文章直接显示；加密文章移至解锁后显示） -->
      {!entry.data.password && shouldShowOutdatedNotice && (
        <PostStaleNoticeBanner
          title={i18n(I18nKey.lastModifiedNoticeTitle)}
          body={staleNoticeBody}
        />
      )}

      <!-- always show cover as long as it has one -->

      {
        processedImage && coverImageConfig.enableInPost && (
          <div style="margin-top:1rem;">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || '')}
              class="mb-8 rounded-xl banner-container onload-animation"
              preview={false}
            />
          </div>
        )
      }

      {/* 密码保护：正文在构建期加密，页面源码中不含明文密码与明文正文 */}
      {entry.data.password ? (
        <div id="password-protection-wrapper">
          <PasswordProtection
            client:idle
            postId={entry.id}
            hint={siteConfig.postPasswordHint ?? ""}
          />
          <EncryptedContent
            password={typeof entry.data.password === 'boolean' ? (siteConfig.postPassword ?? "") : entry.data.password}
          >
            {/* 加密文章：过期提示仅解锁后显示 */}
            {shouldShowOutdatedNotice && (
              <PostStaleNoticeBanner
                title={i18n(I18nKey.lastModifiedNoticeTitle)}
                body={staleNoticeBody}
              />
            )}
            <Markdown class="mb-6 markdown-content onload-animation">
              <Content />
            </Markdown>
          </EncryptedContent>
        </div>
      ) : (
        <Markdown class="mb-6 markdown-content onload-animation">
          <Content />
        </Markdown>
      )}
      
      <script is:inline>
        // 监听密码解锁事件
        window.addEventListener('password-unlocked', function() {
          const wrapper = document.getElementById('password-protection-wrapper');
          const protectedContent = document.getElementById('protected-content');
          
          if (wrapper && protectedContent) {
            // 隐藏密码输入界面，显示文章内容
            const passwordCard = wrapper.querySelector('.password-protection-container');
            if (passwordCard) {
              passwordCard.style.display = 'none';
            }
            protectedContent.style.display = 'block';
            // 正文是解锁后才注入 DOM 的，需要重新触发依赖 astro:page-load 的
            // 初始化逻辑（表格滚动包裹、TOC、代码块复制按钮等）
            document.dispatchEvent(new Event('astro:page-load'));
          }
        });
      </script>

      {/* 赞助按钮 */}
      {
        sponsorConfig.showButtonInPost && siteConfig.pages.sponsor && (
          <div class="mb-6 rounded-xl onload-animation">
            <div class="p-6 bg-(--license-block-bg) rounded-xl">
              <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3 flex-1">
                  <div class="h-12 w-12 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
                    <Icon name="material-symbols:favorite" class="text-2xl" />
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
                      {i18n(I18nKey.sponsorButton)}
                    </h3>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">
                      {i18n(I18nKey.sponsorButtonText)}
                    </p>
                  </div>
                </div>
                <a
                  href={url("/sponsor/")}
                  class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/80 hover:scale-105 active:scale-95 transition-transform whitespace-nowrap"
                >
                  <span>{i18n(I18nKey.sponsor)}</span>
                  <Icon name="fa6-solid:arrow-right" class="text-sm" />
                </a>
              </div>
            </div>
          </div>
        )
      }

      {
        licenseConfig.enable && (
          <License
            title={entry.data.title}
            id={entry.id}
            pubDate={entry.data.published}
            author={entry.data.author}
            sourceLink={entry.data.sourceLink}
            licenseName={entry.data.licenseName}
            licenseUrl={entry.data.licenseUrl}
            class="mb-6 rounded-xl license-container onload-animation"
          />
        )
      }
    </div>
  </div>

  {
    (siteConfig.showPostPrevNext ?? true) &&
      (entry.data.nextSlug || entry.data.prevSlug) && (
        <div class="post-nav flex flex-col md:flex-row justify-between mb-4 gap-4 w-full">
          <a
            href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
            class:list={[
              "post-nav-item active:scale-95",
              { "pointer-events-none": !entry.data.nextSlug },
            ]}
          >
            {
              entry.data.nextSlug && (
                <div class="post-nav-card">
                  <div class="post-nav-label">
                    <Icon
                      name="material-symbols:arrow-back-rounded"
                      class="text-[1.05rem]"
                    />
                    <span>上一篇</span>
                  </div>
                  <div class="post-nav-title">{entry.data.nextTitle}</div>
                </div>
              )
            }
          </a>

          <a
            href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
            class:list={[
              "post-nav-item active:scale-95",
              { "pointer-events-none": !entry.data.prevSlug },
            ]}
          >
            {
              entry.data.prevSlug && (
                <div class="post-nav-card post-nav-card--next">
                  <div class="post-nav-label">
                    <span>下一篇</span>
                    <Icon
                      name="material-symbols:arrow-forward-rounded"
                      class="text-[1.05rem]"
                    />
                  </div>
                  <div class="post-nav-title">{entry.data.prevTitle}</div>
                </div>
              )
            }
          </a>
        </div>
      )
  }

  <!-- 评论 -->
  {entry.data.comment && <Comment post={entry} />}
</MainGridLayout>

<style>
  /* 上一篇/下一篇：方向标签 + 标题的两行结构（参考 ThriveX-Blog 的文章导航）。
     不复用 .btn-card：main.css 里它被强制 border-radius:4px，且是全站按钮样式。 */
  .post-nav-item {
    width: 100%;
    min-width: 0;
  }

  .post-nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-large);
    background: var(--card-bg);
    border: 1px solid var(--juejin-border);
  }

  :root.dark .post-nav-card {
    border-color: rgba(255, 255, 255, 0.08);
  }

  /* 下一篇卡片整体右对齐，形成左右呼应 */
  .post-nav-card--next {
    align-items: flex-end;
  }

  .post-nav-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--juejin-text-tertiary);
  }

  .post-nav-title {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--primary);
  }

  .post-nav-card--next .post-nav-title {
    text-align: right;
  }
</style>
