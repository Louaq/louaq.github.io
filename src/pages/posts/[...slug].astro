---
import { render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import License from "@components/misc/License.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getFileDirFromPath, getResolvedPostPath } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import qrcode from "qrcode-generator";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import PostStaleNoticeBanner from "@/components/layout/PostStaleNoticeBanner.astro";
import EncryptedContent from "@/components/misc/EncryptedContent.astro";
import PasswordProtection from "@/components/misc/PasswordProtection.svelte";
import PromoStrip from "@/components/misc/PromoStrip.astro";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	const seen = new Map<string, string>();
	for (const entry of blogEntries) {
		const segment = getResolvedPostPath(entry.id, entry.data);
		const dup = seen.get(segment);
		if (dup !== undefined) {
			throw new Error(
				`文章路径冲突：「${segment}」同时对应 ${dup} 与 ${entry.id}`,
			);
		}
		seen.set(segment, entry.id);
	}
	return blogEntries.map((entry) => {
		const slug = getResolvedPostPath(entry.id, entry.data);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const processedImage = entry.data.image;

const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const wechatQr = qrcode(0, "M");
wechatQr.addData(shareUrl);
wechatQr.make();
const wechatQrImage = `data:image/svg+xml,${encodeURIComponent(wechatQr.createSvgTag({ cellSize: 6, margin: 24, scalable: true }))}`;

const lastModified = new Date(entry.data.updated || entry.data.published);
const daysDiff = Math.floor((Date.now() - lastModified.getTime()) / 86400000);
const outdatedThreshold = siteConfig.outdatedThreshold ?? 1;
const shouldShowOutdatedNotice =
	siteConfig.showLastModified && daysDiff >= outdatedThreshold;
// sv-SE 的本地化日期格式恰好就是 YYYY-MM-DD，且走构建机本地时区
const lastModifiedDateStr = lastModified.toLocaleDateString("sv-SE");
const lastModifiedMain = `${i18n(I18nKey.lastModifiedPrefix)}${lastModifiedDateStr}${
	daysDiff >= 1
		? `，${i18n(I18nKey.lastModifiedDaysAgo).replace("{days}", daysDiff.toString())}`
		: ""
}`;
const staleNoticeBody = `${lastModifiedMain}${i18n(I18nKey.lastModifiedNoticeJoiner)}${i18n(I18nKey.lastModifiedOutdated)}`;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---

<MainGridLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={getResolvedPostPath(entry.id, entry.data)}
  headings={headings}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <div
    class="flex w-full relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      {/* 顶部推广位（由 config/adConfig.ts 控制，未启用时不渲染） */}
      <PromoStrip placement="top" class="onload-animation" />

      <!-- title -->
      <div class="relative onload-animation">
        <h1
          class="w-full flex items-center gap-2 flex-wrap font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    wrap-break-word
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                    before:absolute before:top-3 before:-left-4.5"
        >
          <span class="min-w-0">{entry.data.title}</span>
          {entry.data.password && (
            <Icon
              name="material-symbols:lock-outline"
              class="inline text-2xl md:text-3xl align-middle -translate-y-px text-inherit shrink-0"
              aria-label="文章已加密"
            />
          )}
        </h1>
      </div>

      <!-- metadata -->
      <div class="onload-animation">
        <PostMetadata
          className="mb-5"
          published={entry.data.published}
          updated={entry.data.updated}
          tags={entry.data.tags}
          category={entry.data.category || undefined}
          id={entry.id}
          hideUpdateDate={!siteConfig.showLastModified}
        />
        {
          !processedImage && (
            <div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
          )
        }
      </div>

      <!-- 过期/过时提醒：置于正文前（非加密文章直接显示；加密文章移至解锁后显示） -->
      {!entry.data.password && shouldShowOutdatedNotice && (
        <PostStaleNoticeBanner
          title={i18n(I18nKey.lastModifiedNoticeTitle)}
          body={staleNoticeBody}
        />
      )}

      <!-- always show cover as long as it has one -->

      {
        processedImage && siteConfig.coverImage.enableInPost && (
          <div style="margin-top:1rem;">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || '')}
              class="mb-8 rounded-xl banner-container onload-animation"
              preview={false}
            />
          </div>
        )
      }

      {/* 密码保护：正文在构建期加密，页面源码中不含明文密码与明文正文 */}
      {entry.data.password ? (
        <div id="password-protection-wrapper">
          <PasswordProtection
            client:idle
            postId={entry.id}
          />
          <EncryptedContent
            password={typeof entry.data.password === 'boolean' ? import.meta.env.PASSWORD : entry.data.password}
          >
            {/* 加密文章：过期提示仅解锁后显示 */}
            {shouldShowOutdatedNotice && (
              <PostStaleNoticeBanner
                title={i18n(I18nKey.lastModifiedNoticeTitle)}
                body={staleNoticeBody}
              />
            )}
            <Markdown class="mb-6 markdown-content onload-animation">
              <Content />
            </Markdown>
          </EncryptedContent>
        </div>
      ) : (
        <Markdown class="mb-6 markdown-content onload-animation">
          <Content />
        </Markdown>
      )}
      

      {
        siteConfig.license.enable && (
          <License
            title={entry.data.title}
            id={entry.id}
            pubDate={entry.data.published}
            author={entry.data.author}
            sourceLink={entry.data.sourceLink}
            licenseName={entry.data.licenseName}
            licenseUrl={entry.data.licenseUrl}
            class="mb-6 rounded-xl license-container onload-animation"
          />
        )
      }

      {/* 底部推广位（由 config/adConfig.ts 控制，未启用时不渲染） */}
      <PromoStrip placement="bottom" class="onload-animation" />

      <div class="flex items-start justify-center gap-6 mt-8 pt-7 pb-3 border-t border-(--line-divider) onload-animation">
        <button
          id="post-share"
          type="button"
          class="group flex flex-col items-center gap-2 min-w-11 text-black/65 dark:text-white/65 hover:text-(--primary) transition-colors"
          title={i18n(I18nKey.rssCopyLink)}
          aria-label={i18n(I18nKey.rssCopyLink)}
          data-url={shareUrl}
          data-label={i18n(I18nKey.postShare)}
          data-copied={i18n(I18nKey.postLinkCopied)}
          data-failed={i18n(I18nKey.postLinkCopyFailed)}
        >
          <span class="flex items-center justify-center w-11 h-11 rounded-full bg-slate-100 dark:bg-white/5 group-hover:bg-slate-200 dark:group-hover:bg-white/10 transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </span>
          <span data-share-label class="text-xs" aria-live="polite">{i18n(I18nKey.postShare)}</span>
        </button>
        <button
          type="button"
          popovertarget="wechat-share"
          class="group flex flex-col items-center gap-2 min-w-11 text-black/65 dark:text-white/65 hover:text-(--primary) transition-colors"
          title={i18n(I18nKey.postQrCode)}
          aria-label={i18n(I18nKey.postQrCode)}
        >
          <span class="flex items-center justify-center w-11 h-11 rounded-full bg-slate-100 dark:bg-white/5 group-hover:bg-slate-200 dark:group-hover:bg-white/10 transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
              <rect x="14" y="14" width="3" height="3"></rect>
              <line x1="21" y1="14" x2="21" y2="14.01"></line>
              <line x1="21" y1="21" x2="21" y2="21.01"></line>
              <line x1="17" y1="21" x2="17" y2="21.01"></line>
            </svg>
          </span>
          <span class="text-xs">{i18n(I18nKey.postQrCode)}</span>
        </button>
      </div>
      <div
        id="wechat-share"
        popover
        class="m-auto rounded-xl border border-(--line-divider) bg-(--card-bg) p-6 text-center shadow-xl text-black/75 dark:text-white/75"
        aria-labelledby="wechat-share-title"
      >
        <h2 id="wechat-share-title" class="font-bold mb-3">{i18n(I18nKey.postQrCode)}</h2>
        <img src={wechatQrImage} width="240" height="240" alt={i18n(I18nKey.postShareWechatGuide)} class="mx-auto bg-white" />
        <p class="text-sm mt-3 max-w-60">{i18n(I18nKey.postShareWechatGuide)}</p>
        <button type="button" popovertarget="wechat-share" popovertargetaction="hide" class="absolute top-2 right-2 flex items-center justify-center w-8 h-8" aria-label="关闭">
          <Icon name="material-symbols:close-rounded" class="text-lg" />
        </button>
      </div>
    </div>
  </div>

  <!-- 评论 -->
  {entry.data.comment && <Comment />}
</MainGridLayout>

<script>
  let copyResetTimer: ReturnType<typeof setTimeout>;

  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("#post-share");
    if (!button) return;

    const label = button.querySelector("[data-share-label]")!;
    try {
      await navigator.clipboard.writeText(button.dataset.url!);
      label.textContent = button.dataset.copied!;
      button.title = button.dataset.copied!;
      clearTimeout(copyResetTimer);
      copyResetTimer = setTimeout(() => {
        label.textContent = button.dataset.label!;
        button.title = button.getAttribute("aria-label")!;
      }, 3000);
    } catch {
      label.textContent = button.dataset.failed!;
      button.title = button.dataset.failed!;
    }
  });
</script>
