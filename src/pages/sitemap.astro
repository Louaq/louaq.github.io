---
import ButtonTag from "@components/common/ButtonTag.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import {
	getArchivePostsList,
	getCategoryList,
	getTagList,
} from "@/utils/content-utils";
import { getPostUrlBySlug, getTagUrl, url } from "@/utils/url-utils";

const [posts, categories, tags] = await Promise.all([
	getArchivePostsList(),
	getCategoryList(),
	getTagList(),
]);

// 站点页面：受 siteConfig.pages 开关控制的三个跟着开关走，其余恒在
const pages = [
	{ name: i18n(I18nKey.home), href: url("/"), icon: "fluent-emoji-flat:house" },
	{
		name: i18n(I18nKey.about),
		href: url("/about/"),
		icon: "fluent-emoji-flat:bust-in-silhouette",
	},
	{
		name: i18n(I18nKey.archive),
		href: url("/archive/"),
		icon: "fluent-emoji-flat:file-folder",
	},
	{
		name: i18n(I18nKey.categories),
		href: url("/categories/"),
		icon: "fluent-emoji-flat:open-file-folder",
	},
	{
		name: i18n(I18nKey.tags),
		href: url("/tags/"),
		icon: "fluent-emoji-flat:label",
	},
	siteConfig.pages.friends && {
		name: i18n(I18nKey.friends),
		href: url("/friends/"),
		icon: "fluent-emoji-flat:handshake",
	},
	siteConfig.pages.watchlist && {
		name: i18n(I18nKey.watchlist),
		href: url("/watchlist/"),
		icon: "fluent-emoji-flat:clapper-board",
	},
	siteConfig.pages.guestbook && {
		name: i18n(I18nKey.guestbook),
		href: url("/guestbook/"),
		icon: "fluent-emoji-flat:speech-balloon",
	},
	siteConfig.pages.sponsor && {
		name: i18n(I18nKey.sponsor),
		href: url("/sponsor/"),
		icon: "fluent-emoji-flat:red-heart",
	},
	{
		name: i18n(I18nKey.rss),
		href: url("/rss/"),
		icon: "fluent-emoji-flat:satellite-antenna",
	},
].filter((page) => page !== false);

// 文章按年倒序分组
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.published.getUTCFullYear();
	const group = byYear.get(year);
	if (group) {
		group.push(post);
	} else {
		byYear.set(year, [post]);
	}
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const postLabel = i18n(I18nKey.postsCount);
---

<MainGridLayout
	title={i18n(I18nKey.sitemap)}
	description={i18n(I18nKey.sitemapDescription)}
	hideSidebar
	wideContent
>
	<div class="card-base card-plain px-8 py-6 mb-4">
		<h2 class="sitemap-heading">
			<Icon name="material-symbols:home-outline-rounded" class="text-2xl" />
			{i18n(I18nKey.sitemapPages)}
		</h2>
		<div class="flex gap-2 flex-wrap">
			{pages.map((page) => (
				<a href={page.href} aria-label={page.name}
					class="btn-regular h-9 text-sm px-3 rounded-lg gap-2">
					<Icon name={page.icon} class="text-lg" />
					{page.name}
				</a>
			))}
		</div>
	</div>

	<div class="card-base card-plain px-8 py-6 mb-4">
		<h2 class="sitemap-heading">
			<Icon name="material-symbols:folder-open-outline-rounded" class="text-2xl" />
			{i18n(I18nKey.categories)}
			<span class="sitemap-count">{categories.length}</span>
		</h2>
		<div class="flex gap-2 flex-wrap">
			{categories.map((category) => (
				<ButtonTag href={category.url} label={category.name} dot>
					{category.name}
					<span class="text-30 ml-1">{category.count}</span>
				</ButtonTag>
			))}
		</div>
	</div>

	<div class="card-base card-plain px-8 py-6 mb-4">
		<h2 class="sitemap-heading">
			<Icon name="material-symbols:tag-rounded" class="text-2xl" />
			{i18n(I18nKey.tags)}
			<span class="sitemap-count">{tags.length}</span>
		</h2>
		<div class="flex gap-2 flex-wrap">
			{tags.map((tag) => (
				<ButtonTag href={getTagUrl(tag.name)} label={tag.name}>
					{tag.name}
					<span class="text-30 ml-1">{tag.count}</span>
				</ButtonTag>
			))}
		</div>
	</div>

	<div class="card-base card-plain px-8 py-6">
		<h2 class="sitemap-heading">
			<Icon name="material-symbols:notes-rounded" class="text-2xl" />
			{i18n(I18nKey.archive)}
			<span class="sitemap-count">{posts.length} {postLabel}</span>
		</h2>
		{years.map((year) => (
			<section class="mb-5 last:mb-0">
				<h3 class="text-lg font-bold text-75 mb-2">{year}</h3>
				<ul class="sitemap-post-list">
					{byYear.get(year)?.map((post) => (
						<li>
							<a href={getPostUrlBySlug(post.pathSlug)} aria-label={post.title}
								class="sitemap-post-link">
								<span class="truncate">{post.title}</span>
								{post.password && (
									<Icon name="material-symbols:lock-outline"
										class="text-base shrink-0" aria-label="加密" />
								)}
							</a>
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
</MainGridLayout>

<style>
	.sitemap-heading {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: 1rem;
		color: var(--primary);
	}

	.sitemap-count {
		font-size: 0.875rem;
		font-weight: 400;
		color: var(--content-meta);
	}

	/* 窄屏单列，宽屏两到三列，避免长文章列表拉出一屏又一屏 */
	.sitemap-post-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.125rem 1.5rem;
	}

	@media (min-width: 768px) {
		.sitemap-post-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1280px) {
		.sitemap-post-list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.sitemap-post-link {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		min-width: 0;
		padding: 0.25rem 0.5rem;
		margin-left: -0.5rem;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		color: var(--content-meta);
		transition: background-color 0.15s, color 0.15s;
	}

	.sitemap-post-link:hover {
		color: var(--primary);
		background-color: var(--btn-plain-bg-hover);
	}
</style>
