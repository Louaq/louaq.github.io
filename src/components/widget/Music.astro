---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config";
import { musicConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
---

<WidgetLayout
  name={i18n(I18nKey.music)}
  icon="fluent-emoji-flat:musical-notes"
  id="music"
  class={className}
  style={style}
>
  <div
      id="music-player"
      data-api={musicConfig.api}
      data-songs={url("/music.json")}
      data-theme={siteConfig.themeColor.color}
      data-search={i18n(I18nKey.search)}
  >
    {/* 加载占位：APlayer 初始化时会覆盖容器 innerHTML，占位自然消失 */}
    <div class="relative h-[66px]">
      <div class="flex h-full items-center gap-3 blur-sm opacity-50">
        <div class="size-[66px] shrink-0 rounded-lg bg-(--primary)/20"></div>
        <div class="flex-1 space-y-2">
          <div class="h-3 w-1/2 rounded bg-neutral-300 dark:bg-neutral-600"></div>
          <div class="h-2 w-full rounded bg-neutral-200 dark:bg-neutral-700"></div>
        </div>
      </div>
      <Icon name="material-symbols:autorenew-rounded" class="absolute inset-0 m-auto size-8 animate-spin text-(--primary)" />
    </div>
  </div>
</WidgetLayout>

<style is:global>
  /* 去掉 APlayer 自带的卡片外观，融进侧边栏卡片；用 id 压过运行时插入的 APlayer.min.css */
  #music-player.aplayer {
    margin: 0;
    box-shadow: none;
    background: transparent;
  }
  /* 当前播放项左侧的主题色竖条 */
  #music-player .aplayer-list-cur {
    display: none;
  }
  /* 列表项悬停和当前播放的背景加圆角，与搜索框一致 */
  #music-player .aplayer-list ol li {
    border-radius: 0.5rem;
  }
</style>

{/* module 脚本整站只跑一次；APlayer 动态导入，不阻塞首屏渲染 */}
<script>
    import aplayerCss from "aplayer/dist/APlayer.min.css?url";
    if (!matchMedia("(max-width: 768px)").matches) {
        document.head.append(Object.assign(document.createElement("link"), { id: "aplayer-css", rel: "stylesheet", href: aplayerCss }));

        const el = document.getElementById("music-player") as HTMLElement;
        const api = el.dataset.api as string;

        const [{ default: APlayer }, songs] = await Promise.all([
            import("aplayer"),
            fetch(el.dataset.songs as string).then((r) => r.json()),
        ]);

        let loading: object | null = null;
        const load = (song: { id: number }) => {
            if (loading === song) return;
            loading = song;
            // 不带站点 cookie：API 收到任何 Cookie 头都会改用它而不用服务端的会员 cookie，url 变成 null
            return fetch(`${api}/song/url/v1?id=${song.id}&level=exhigh`, { credentials: "omit" })
                .then((r) => r.json())
                .then(({ data }) => {
                    // 连续切歌时只采用当前这首的结果
                    if (ap.list.audios[ap.list.index] !== song) return;
                    // 无版权的歌 url 为 null，直接切下一首
                    if (!data[0].url) return ap.skipForward();
                    ap.audio.src = data[0].url.replace(/^http:/, "https:");
                    if (!ap.paused) ap.audio.play();
                });
        };

        const ap = new APlayer({
            container: el,
            listFolded: true,
            theme: el.dataset.theme,
            audio: songs.map((s: object) => ({ ...s, type: "netease" })),
            customAudioType: {
                // 不能写成 async 函数：APlayer 用 toString 判断类型，AsyncFunction 会报 Illegal customType
                // 初始化和暂停状态下切歌只清空地址，不请求接口，避免每个访客打开页面就消耗一次会员取链
                netease: (audio: HTMLAudioElement, song: { id: number }, player: { paused: boolean }) => {
                    // 只删 src 属性不会卸载已加载的上一首，播完切歌后 APlayer 紧接着 play() 会把它从头放出来；load() 才真正清空
                    audio.removeAttribute("src");
                    audio.load();
                    if (!player.paused) load(song);
                },
            },
        });

        // 暂停状态下点播放：此时还没有地址，现取
        ap.on("play", () => {
            if (!ap.audio.getAttribute("src")) load(ap.list.audios[ap.list.index]);
        });

        const labels = songs.map((s: { name: string; artist: string }) => `${s.name} ${s.artist}`.toLowerCase());
        const search = Object.assign(document.createElement("input"), {
            type: "search",
            placeholder: el.dataset.search,
            className: "my-2 w-full rounded-lg bg-black/5 px-3 py-1.5 text-sm outline-none focus:ring-2 focus:ring-(--primary) focus:ring-inset dark:bg-white/10",
        });
        
        search.style.boxSizing = "border-box";

        search.addEventListener("click", (e) => e.stopPropagation());
        search.addEventListener("input", () => {
            const q = search.value.trim().toLowerCase();
            [...ap.template.listOl.children].forEach((li, i) => {
                (li as HTMLElement).hidden = !labels[i].includes(q);
            });
        });
        ap.template.list.prepend(search);
        ap.template.list.style.maxHeight = "calc(250px + 3rem)";
        // APlayer 切歌（及展开列表）时会把列表滚到 33*index，选中的歌被顶到最上面；屏蔽它对 scrollTop 的写入，用户滚轮滚动不受影响
        Object.defineProperty(ap.template.listOl, "scrollTop", { set() {} });

        document.addEventListener("astro:page-load", () => {
            const slot = document.getElementById("music-player");
            if (slot && slot !== el) slot.replaceWith(el);
        });
    }
</script>
