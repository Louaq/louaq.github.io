---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
---

<WidgetLayout
  name={i18n(I18nKey.solarTerm)}
  icon="fluent-emoji-flat:sheaf-of-rice"
  id="solar-term"
  class={className}
  style={style}
>
  <div class="solar-term">
    <img class="w-full rounded-lg" alt="" width="238" height="357" hidden />
  </div>
</WidgetLayout>

<script>
  type TermEvent = {
    name: string;
    category: string;
    start: string;
    card: { image: string };
  };

  const state = ((window as any).__solarTermState ??= {}) as {
    card?: Promise<{ name: string; src: string }>;
    listenerAdded?: boolean;
  };

  const calendar = (year: number): Promise<TermEvent[]> =>
    fetch(`https://api.jieqi.dev/v1/calendar/${year}.json?style=character`)
      .then((r) => r.json())
      .then((j) => j.events.filter((e: TermEvent) => e.category === "solar-term"));

  const today = () => new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Shanghai" }).format(new Date());

  async function currentTerm() {
    const year = Number(today().slice(0, 4));
    const terms = (await Promise.all([year - 1, year, year + 1].map(calendar))).flat();
    const i = terms.findLastIndex((e) => e.start <= today());
    return { term: terms[i], until: terms[i + 1].start };
  }

  const CACHE_KEY = "solar-term";

  async function cachedTerm(): Promise<TermEvent> {
    const cached = JSON.parse(localStorage.getItem(CACHE_KEY) ?? "null");
    if (cached && today() < cached.until) return cached.term;
    const fresh = await currentTerm();
    localStorage.setItem(CACHE_KEY, JSON.stringify(fresh));
    return fresh.term;
  }

  async function cachedImage(src: string) {
    let res = await (await caches.open(CACHE_KEY)).match(src);
    if (!res) {
      await caches.delete(CACHE_KEY);
      res = await fetch(src);
      await (await caches.open(CACHE_KEY)).put(src, res.clone());
    }
    return URL.createObjectURL(await res.blob());
  }

  async function loadCard() {
    const term = await cachedTerm();
    return { name: term.name, src: await cachedImage(term.card.image) };
  }

  async function renderSolarTerm() {
    const root = document.querySelector<HTMLElement>(".solar-term");
    if (!root) return;
    state.card ??= loadCard();
    const card = await state.card;
    const img = root.querySelector("img")!;
    img.src = card.src;
    img.alt = card.name;
    img.hidden = false;
  }

  renderSolarTerm();

  if (!state.listenerAdded) {
    state.listenerAdded = true;
    document.addEventListener("astro:page-load", renderSolarTerm);
  }
</script>
