---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getCategoryList, getTagList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

/** 站内路径走 BASE_URL，外链/raw mailto 原样 */
function resolveProfileHref(href?: string): string | undefined {
	const h = href?.trim();
	if (!h) return undefined;
	if (/^https?:\/\//i.test(h) || h.startsWith("mailto:")) return h;
	return url(h.startsWith("/") ? h : `/${h}`);
}

/** Swup 会按 HTML 取同站链接；rss.xml 等需整页打开，用默认的 data-no-swup 忽略规则 */
function isNonHtmlInternalPath(profileUrl?: string): boolean {
	const h = profileUrl?.trim();
	if (!h || /^https?:\/\//i.test(h) || h.startsWith("mailto:")) return false;
	const pathOnly = (h.split("?")[0] ?? "").split("#")[0] ?? "";
	const normalized = pathOnly.startsWith("/") ? pathOnly : `/${pathOnly}`;
	return normalized.toLowerCase().endsWith(".xml");
}

function isGithubLink(item: { url: string; icon?: string }): boolean {
	return (
		/github\.com/i.test(item.url) ||
		(item.icon ?? "").toLowerCase().includes("github")
	);
}

/** icon 以 "/" 开头视为 public/ 下的本地 SVG 文件路径，否则视为 Iconify "prefix:name" */
function isLocalIconPath(icon: string): boolean {
	return icon.startsWith("/");
}

const level = profileConfig.level?.trim();
const coverSrc = profileConfig.cover?.trim();

const tags = await getTagList();
const categories = await getCategoryList();
const tagCount = tags.length;
const categoryCount = categories.length;
---

<div class="card-base profile-card-hero overflow-hidden p-0 rounded-2xl shadow-xs border border-black/6 dark:border-white/10">
  <!-- 头图区 -->
  <div class="profile-cover-wrap relative h-26">
    {
      coverSrc ? (
        <img
          src={coverSrc}
          alt=""
          aria-hidden="true"
          width="544"
          height="104"
          class="absolute inset-0 h-full w-full object-cover object-center"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      ) : (
        <div class="absolute inset-0 bg-linear-to-br from-slate-500 via-slate-600 to-slate-800" />
      )
    }
    <div
      class="absolute inset-0 bg-linear-to-t from-black/65 via-black/25 to-transparent"
      aria-hidden="true"
    />

    <div
      class="profile-hero-avatar absolute left-4 bottom-0 z-20 block h-16 w-16 translate-y-1/2 rounded-full"
    >
      <div class="relative h-full w-full overflow-hidden rounded-full">
        <ImageWrapper
          src={profileConfig.avatar || ""}
          alt="Profile Image of the Author"
          width={64}
          height={64}
          class="h-full w-full object-cover"
        />
      </div>
    </div>

    <div class="absolute bottom-2.5 left-0 right-3 z-10 min-w-0 pl-21 text-white">
      <div class="flex flex-wrap items-center gap-2">
        <span
          class="profile-hero-name truncate text-lg font-bold leading-snug text-white drop-shadow-xs"
        >
          {profileConfig.name}
        </span>
        {
          level && (
            <span
              class="inline-flex shrink-0 items-center rounded-sm px-1.5 py-0 text-[12px] font-semibold leading-5 text-[#8bf268] ring-1 ring-white/35 bg-white/15"
              aria-label={`等级 ${level}`}
            >
              {level}
            </span>
          )
        }
      </div>
      <div class="mt-1 flex flex-wrap gap-x-4 gap-y-0.5 text-sm text-white/90">
        <span class="">
          {tagCount} {i18n(I18nKey.tags)}
        </span>
        <span class="">
          {categoryCount} {i18n(I18nKey.categories)}
        </span>
      </div>
    </div>
  </div>

  <!-- 白色内容区 -->
  <div class="profile-hero-body px-4 pb-4 pt-10 dark:bg-transparent">
    {
      profileConfig.bio?.trim() && (
        <p
          class="text-[18px] leading-snug text-neutral-500 dark:text-neutral-400 line-clamp-3"
          title={profileConfig.bio}
        >
          {profileConfig.bio}
        </p>
      )
    }

    {
      profileConfig.links.length > 0 && (
        <div class="profile-actions-row mt-4 w-full min-h-10">
          <div class="profile-actions-track flex flex-wrap items-center gap-0.5">
            {profileConfig.links.map((item) => {
              if (item.url.startsWith("mailto:")) {
                const encodedEmail = Buffer.from(
                  item.url.replace("mailto:", ""),
                ).toString("base64");
                return (
                  <a
                    rel="me"
                    aria-label={item.name}
                    href="#"
                    data-encoded-email={encodedEmail}
                    onclick={`
                (function() {
                  const encodedEmail = this.getAttribute('data-encoded-email');
                  const decodedEmail = atob(encodedEmail);
                  this.href = 'mailto:' + decodedEmail;
                  this.removeAttribute('data-encoded-email');
                  this.removeAttribute('onclick');
                  this.click();
                  return false;
                }).call(this);
              `
                      .replace(/\s+/g, " ")
                      .trim()}
                    class="profile-link-btn shrink-0"
                    title={item.name}
                  >
                    {isLocalIconPath(item.icon) ? (
                      <img src={url(item.icon)} alt="" class="h-6 w-6" aria-hidden="true" />
                    ) : (
                      <Icon name={item.icon} class="text-2xl" aria-hidden="true" />
                    )}
                  </a>
                );
              }
              if (isGithubLink(item)) {
                return (
                  <a
                    href={item.url}
                    target="_blank"
                    rel="me noopener noreferrer"
                    class="profile-link-btn shrink-0"
                    aria-label={item.name}
                    title={item.name}
                  >
                    {isLocalIconPath(item.icon) ? (
                      <img src={url(item.icon)} alt="" class="h-6 w-6" aria-hidden="true" />
                    ) : (
                      <Icon name={item.icon} class="text-2xl" aria-hidden="true" />
                    )}
                  </a>
                );
              }
              const isExt = /^https?:/i.test(item.url);
              const internalHref = resolveProfileHref(item.url) ?? item.url;
              const skipSwup = !isExt && isNonHtmlInternalPath(item.url);
              return (
                <a
                  aria-label={item.name}
                  href={internalHref}
                  target={isExt || skipSwup ? "_blank" : undefined}
                  rel={isExt || skipSwup ? "me noopener noreferrer" : "me"}
                  class="profile-link-btn shrink-0"
                  title={item.name}
                  {...(skipSwup ? { "data-no-swup": "" } : {})}
                >
                  {isLocalIconPath(item.icon) ? (
                    <img src={url(item.icon)} alt="" class="h-6 w-6" />
                  ) : (
                    <Icon name={item.icon} class="text-2xl" />
                  )}
                </a>
              );
            })}
          </div>
        </div>
      )
    }
  </div>
</div>

<style is:global>
  /* 社交行：仅图标本身，无底色、无悬浮动画 */
  .profile-card-hero .profile-link-btn {
    width: 44px;
    height: 44px;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
  }
</style>
