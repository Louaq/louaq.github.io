---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const config = announcementConfig;
const hasLink = Boolean(config.link && config.link.enable !== false);

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<!-- 组件显示现在由sidebarLayoutConfig统一控制，无需检查config.enable -->
<WidgetLayout id="announcement" class={className} style={style}>
  <div class="-mx-4 -mt-4 mb-3 h-36 overflow-hidden">
    <img
      src="/assets/images/announcement-girls.webp"
      alt=""
      class="h-full w-full object-cover object-top select-none pointer-events-none"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div>
    <!-- 标题行：图标 + 标题 + 可选箭头 -->
    <div class="flex items-center gap-1.5 mb-2 text-lg">
      <Icon
        name="announcement"
        class="icon-shake shrink-0 size-[1.05em]"
        aria-hidden="true"
      />
      <span class="flex-1 min-w-0 font-bold text-neutral-900 dark:text-neutral-100 truncate">
        {config.title || i18n(I18nKey.announcement)}
      </span>
      {
        hasLink && (
          <Icon
            name="fa6-solid:chevron-right"
            class="shrink-0 text-xs text-neutral-300 dark:text-neutral-600"
            aria-hidden="true"
          />
        )
      }
    </div>

    <!-- 公告栏内容 -->
    <div class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3">
      {config.content}
    </div>

    <!-- 可选链接和关闭按钮 -->
    <div class="flex items-center justify-between gap-3">
      <div>
        {
          config.link && config.link.enable !== false && (
            <a
              href={config.link.url}
              target={config.link.external ? "_blank" : "_self"}
              rel={config.link.external ? "noopener noreferrer" : undefined}
              class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform"
            >
              {config.link.text}
            </a>
          )
        }
      </div>

      {
        config.closable && (
          <button
            class="btn-regular rounded-lg h-8 w-8 text-sm hover:bg-red-100 dark:hover:bg-red-900/30"
            onclick="closeAnnouncement()"
            aria-label={i18n(I18nKey.announcementClose)}
          >
            <Icon name="fa6-solid:xmark" class="text-sm" />
          </button>
        )
      }
    </div>
  </div>
</WidgetLayout>

<script>
  function closeAnnouncement() {
    // 通过data-id属性找到整个widget-layout元素
    const widgetLayout = document.querySelector(
      'widget-layout[data-id="announcement"]'
    ) as HTMLElement | null;
    if (widgetLayout) {
      // 隐藏整个widget-layout元素
      widgetLayout.style.display = "none";
    }
  }

  // 页面加载时检查是否已关闭
  document.addEventListener("DOMContentLoaded", function () {
    const widgetLayout = document.querySelector(
      'widget-layout[data-id="announcement"]'
    ) as HTMLElement | null;
    if (widgetLayout && localStorage.getItem("announcementClosed") === "true") {
      widgetLayout.style.display = "none";
    }
  });

  // 使公告栏函数全局可用
  window.closeAnnouncement = closeAnnouncement;
</script>
