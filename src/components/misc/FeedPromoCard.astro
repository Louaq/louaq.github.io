---
import { Icon } from "astro-icon/components";
import type { AdFeedItem } from "@/types/config";
import { url } from "@/utils/url-utils";

export interface Props {
	item: AdFeedItem;
	/** 在整个列表里的渲染序号，决定配图落在左边还是右边（与文章卡交替节奏一致） */
	index?: number;
	class?: string;
	style?: string;
}

const {
	item,
	index = 0,
	class: className = "",
	style = "",
} = Astro.props as Props;

const isEven = index % 2 === 0;
const hasImage = Boolean(item.image);
const imageSrc = hasImage
	? item.image?.startsWith("/")
		? url(item.image)
		: item.image
	: undefined;
const href = item.link
	? item.link.startsWith("/")
		? url(item.link)
		: item.link
	: undefined;

// 结构与类名刻意对齐 PostCard 的 .post-card-wrapper.hero-card：卡片高度、斜切封面、
// grid / list / 瀑布流三种布局的适配规则全在那边的全局样式里，这里复用即可，
// 不必再写一套。.post-card-item 是瀑布流脚本的定位选择器，少了会被漏排。
//
// 类名同样避开 ad / advertisement / sponsor：EasyList 一类拦截名单带通用元素规则，
// 命中后服务端渲染再正确也会被整块隐藏（详见 utils/promo-init.ts 的说明）。
---

<div
  class:list={[
    "post-card-wrapper hero-card promo-feed-card",
    isEven ? "hero-card--even" : "hero-card--odd",
    hasImage ? "has-cover" : "",
    "card-base flex w-full overflow-hidden rounded-(--radius-large)",
    "post-card-item",
    className,
  ]}
  style={style}
  data-promo-id={item.id}
>
  {/* 左侧配图（偶数项） */}
  {
    hasImage && isEven && (
      <div class="hero-card-side hidden sm:block relative min-w-[45%] overflow-hidden z-10">
        <img
          class="promo-feed-img h-full w-full"
          src={imageSrc}
          alt={item.alt || ""}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div
    class:list={[
      "hero-card-content relative z-20 flex flex-col justify-between h-full pt-9 pb-5 px-5 sm:px-8",
      hasImage ? "w-full sm:w-[65%]" : "w-full",
    ]}
  >
    <div class="hero-card-title promo-feed-title my-1 font-bold text-lg md:text-xl line-clamp-1 text-center sm:text-left">
      {item.title}
    </div>

    {
      item.description && (
        <div class="hero-card-desc text-sm line-clamp-2 xl:line-clamp-3 text-center sm:text-left">
          {item.description}
        </div>
      )
    }

    <div
      class:list={[
        "hero-card-meta inline-flex flex-wrap items-center justify-center",
        isEven ? "sm:justify-end" : "sm:justify-start",
      ]}
    >
      <span class="hero-card-meta-item promo-feed-cta inline-flex items-center gap-1 text-xs">
        <span class="whitespace-nowrap">{item.cta || "了解更多"}</span>
        <Icon name="material-symbols:arrow-forward-rounded" class="size-3.5 shrink-0" />
      </span>
    </div>
  </div>

  {/* 右侧配图（奇数项） */}
  {
    hasImage && !isEven && (
      <div class="hero-card-side hidden sm:block relative min-w-[45%] overflow-hidden z-10">
        <img
          class="promo-feed-img h-full w-full"
          src={imageSrc}
          alt={item.alt || ""}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  {/* 整卡点击热区：盖在内容之上、角标之下；没配 link 时不渲染，整卡即不可点击 */}
  {
    href && (
      <a
        class="promo-feed-hit absolute inset-0 z-30"
        href={href}
        target={item.external ? "_blank" : undefined}
        rel={item.external ? "noopener noreferrer sponsored" : "sponsored"}
        aria-label={item.title}
      />
    )
  }

  {
    item.closable && (
      <button
        type="button"
        class="promo-badge promo-close"
        aria-label={`关闭广告：${item.title}`}
      >
        关闭
      </button>
    )
  }

  <span class="promo-badge promo-tag">{item.label || "广告"}</span>
</div>

<style>
  /* 关闭后由 promo-init.ts 置 [hidden]；卡片自身是 display:flex，
     会盖掉 UA 的 [hidden]{display:none}，这里必须显式收掉 */
  .promo-feed-card[hidden] {
    display: none !important;
  }

  .promo-feed-img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  /* 标题不是链接，去掉 .hero-card-title 的 hover 变色以外的交互暗示；
     整卡 hover 时仍给一点反馈，和文章卡观感一致 */
  .promo-feed-card:hover .promo-feed-title {
    color: var(--primary);
  }

  .promo-feed-cta {
    color: var(--primary);
    opacity: 0.9;
  }

  /* 两个角标：左上「关闭」、右上「广告」，样式与横幅位一致，
     层级压过整卡热区，否则点关闭会先落到链接上 */
  .promo-badge {
    position: absolute;
    top: 0;
    z-index: 40;
    padding: 0.075rem 0.3rem;
    font-size: 0.625rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    user-select: none;
  }

  .promo-close {
    left: 0;
    border-bottom-right-radius: 0.375rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .promo-close:hover {
    color: #fff;
    background: rgba(0, 0, 0, 0.7);
  }

  .promo-tag {
    right: 0;
    border-bottom-left-radius: 0.375rem;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-close {
      transition: none;
    }
  }
</style>
