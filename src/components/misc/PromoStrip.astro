---
import { getActiveAdItems, getAdAspectRatio } from "@/config/adConfig";
import type { AdPlacementName } from "@/types/config";
import { url } from "@/utils/url-utils";

export interface Props {
	placement: AdPlacementName;
	class?: string;
	style?: string;
}

const { placement, class: className = "", style = "" } = Astro.props as Props;

// 是否启用、条目是否过期，全部由 adConfig.ts 决定
const items = getActiveAdItems(placement);

if (items.length === 0) {
	return null;
}

const aspectRatio = getAdAspectRatio(placement);

// 侧边栏的入场动画延迟由 widgetManager 以内联 style 传进来，拼在宽高比变量后面
const rootStyle = [`--promo-aspect: ${aspectRatio}`, style]
	.filter(Boolean)
	.join("; ");

// 关闭按钮的交互由 Layout 常驻脚本里的 initPromoStrip() 统一接管（见 utils/promo-init.ts），
// 这里只负责标记结构：.promo-strip 容器 + 每条的 data-promo-id。
//
// 命名刻意避开 ad / advertisement / banner 这类词：EasyList 等拦截名单带有大量
// 通用元素规则（##.ad-item、##.ad-strip、##[class*="-ad-"] 等），一旦命中，服务端
// 渲染完全正常的广告位也会在装了拦截插件的浏览器里被整块隐藏。
---

<div
  class:list={["promo-strip", className]}
  data-promo-placement={placement}
  style={rootStyle}
>
  {
    items.map((item) => (
      <div class="promo-item" data-promo-id={item.id}>
        {/* link 留空时不加 href：无 href 的 <a> 本身就不可点击、不可聚焦 */}
        <a
          class="promo-link"
          href={
            item.link
              ? item.link.startsWith("/")
                ? url(item.link)
                : item.link
              : undefined
          }
          target={item.link && item.external ? "_blank" : undefined}
          rel={
            item.link
              ? item.external
                ? "noopener noreferrer sponsored"
                : "sponsored"
              : undefined
          }
        >
          {item.image ? (
            <img
              src={item.image.startsWith("/") ? url(item.image) : item.image}
              alt={item.alt || ""}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="promo-placeholder">
              {item.placeholderText || "广告位"}
            </span>
          )}
        </a>

        {item.closable && (
          <button type="button" class="promo-badge promo-close" aria-label={`关闭广告：${item.alt || item.placeholderText || "广告位"}`}>
            关闭
          </button>
        )}

        <span class="promo-badge promo-tag">{item.label || "广告"}</span>
      </div>
    ))
  }
</div>

<style>
  .promo-strip {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  /* 一行最多三条：窄屏单列，中屏两列，宽屏三列 */
  @media (min-width: 640px) {
    .promo-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .promo-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .promo-item {
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--card-bg);
    line-height: 0;
  }

  /* display:grid / block 会盖掉 [hidden] 的 UA display:none，得显式声明 */
  .promo-strip[hidden],
  .promo-item[hidden] {
    display: none;
  }

  .promo-link {
    display: block;
  }

  .promo-item img {
    width: 100%;
    aspect-ratio: var(--promo-aspect);
    object-fit: cover;
    display: block;
  }

  /* 左上「关闭」与右上「广告」两个角标，样式一致，只有贴边方向不同 */
  .promo-badge {
    position: absolute;
    top: 0;
    z-index: 1;
    padding: 0.075rem 0.3rem;
    font-size: 0.625rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    user-select: none;
  }

  .promo-close {
    left: 0;
    border-bottom-right-radius: 0.375rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .promo-close:hover {
    color: #fff;
    background: rgba(0, 0, 0, 0.7);
  }

  .promo-tag {
    right: 0;
    border-bottom-left-radius: 0.375rem;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-close {
      transition: none;
    }
  }

  /* 没配 image 时的占位块：撑住同样的宽高比，虚线框 + 居中文字 */
  .promo-placeholder {
    display: grid;
    /* 水平垂直一起居中；比 flex 那两行更难被别的规则拆散 */
    place-items: center;
    place-content: center;
    width: 100%;
    /* --promo-aspect 由 .promo-strip 的内联 style 传下来，带上兜底比例以防继承断掉 */
    aspect-ratio: var(--promo-aspect, 350 / 60);
    box-sizing: border-box;
    padding: 0.25rem 0.5rem;
    border: 1px dashed var(--line-divider);
    border-radius: inherit;
    font-size: 0.8125rem;
    /* .promo-item 上是 line-height: 0，这里必须显式恢复，否则文字会贴着顶边 */
    line-height: 1.4;
    letter-spacing: 0.05em;
    text-align: center;
    color: var(--primary-text-color);
    opacity: 0.45;
  }

  /* 侧边栏只有约 300px 宽，上面那两条按视口宽度分列的媒体查询在这里会把三张图
     挤成一排。侧边栏固定单列堆叠，外间距也交给侧边栏自己的 gap 控制。 */
  .promo-strip[data-promo-placement="sidebar"] {
    grid-template-columns: 1fr;
    margin-bottom: 0;
  }
</style>
