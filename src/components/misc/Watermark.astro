---
// 正文上方平铺的斜向文字水印，内容与样式见 config/watermarkConfig.ts
import { watermarkConfig } from "@/config/watermarkConfig";

const { enable, text, fontSize, color, rotate, gapX, gapY } = watermarkConfig;
const watermarkSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="${gapX}" height="${gapY}"><text x="50%" y="50%" text-anchor="middle" dominant-baseline="middle" transform="rotate(${rotate} ${gapX / 2} ${gapY / 2})" font-size="${fontSize}" fill="${color}">${text}</text></svg>`;
const watermarkStyle = enable
	? `--watermark: url("data:image/svg+xml,${encodeURIComponent(watermarkSvg)}");`
	: "";
---

<div class="watermark" style={watermarkStyle}>
  <slot />
</div>

<style>
  .watermark {
    position: relative;
  }

  .watermark::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    background-image: var(--watermark);
  }
</style>
