---
import { Icon as AstroIcon } from "astro-icon/components";
import { applyEmail, applyEmailTemplate, applySteps } from "./applyDialogData";

// 「申请友链」弹窗。文案见同目录的 applyDialogData.ts。
// 触发按钮由页面自行放置，只需用 <friend-apply-trigger> 包裹一个 <button>，
// 本组件注册的自定义元素会接管点击并打开弹窗。
// 可复制字段复用页面上的 <friend-copy-field> 自定义元素。
//
// 布局约定：
// 1. 纯提示性弹窗，没有提交动作，所以不设底部操作栏，只保留右上角关闭。
// 2. 目标是一屏放下不滚动，因此三步流程横排。
// 3. 不使用任何布局用的包装元素（无 div 套 div）：一律用语义标签当网格容器，
//    子元素靠 grid-area 定位，样式见下方 <style>。
---

<friend-apply-dialog>
  <dialog id="friend-apply-dialog" class="friend-apply-dialog">
    <article class="friend-apply-panel">
      <header class="friend-apply-header">
        <span class="friend-apply-header-glow" aria-hidden="true"></span>
        <span class="friend-apply-header-icon">
          <AstroIcon name="material-symbols:link-rounded" class="w-5 h-5" />
        </span>
        <h3 class="friend-apply-title">申请友链</h3>
        <p class="friend-apply-subtitle">按照以下步骤将本站加入你的友链，即可申请互换</p>
        <button type="button" class="friend-apply-close" aria-label="关闭">
          <AstroIcon name="material-symbols:close-rounded" class="w-5 h-5" />
        </button>
      </header>

      <ol class="friend-apply-steps">
        {applySteps.map((step, index) => (
          <li class="friend-apply-step">
            <span class="friend-apply-step-num" aria-hidden="true">{index + 1}</span>
            <p class="friend-apply-step-title">{step.title}</p>
            <p class="friend-apply-step-desc">{step.desc}</p>
          </li>
        ))}
      </ol>

      <h4 class="friend-apply-section">
        <AstroIcon name="material-symbols:mail-outline-rounded" class="w-[1.05rem] h-[1.05rem]" />
        申请模板
      </h4>

      <friend-copy-field
        class="friend-copy-field friend-apply-field"
        data-copy-value={applyEmail}
      >
        <span class="friend-apply-field-label">收件邮箱</span>
        <span class="friend-apply-field-value" title={applyEmail}>{applyEmail}</span>
        <button type="button" class="friend-copy-btn friend-apply-copy" aria-label="复制邮箱">
          <AstroIcon
            name="material-symbols:content-copy-outline-rounded"
            class="friend-copy-icon-default w-3.5 h-3.5"
          />
          <AstroIcon
            name="material-symbols:check-rounded"
            class="friend-copy-icon-success w-3.5 h-3.5 text-green-500"
          />
        </button>
      </friend-copy-field>

      <friend-copy-field
        class="friend-copy-field friend-apply-template"
        data-copy-value={applyEmailTemplate}
      >
        <span class="friend-apply-field-label">邮件内容</span>
        <button type="button" class="friend-copy-btn friend-apply-copy" aria-label="复制模板">
          <AstroIcon
            name="material-symbols:content-copy-outline-rounded"
            class="friend-copy-icon-default w-3.5 h-3.5"
          />
          <AstroIcon
            name="material-symbols:check-rounded"
            class="friend-copy-icon-success w-3.5 h-3.5 text-green-500"
          />
        </button>
        <pre class="friend-apply-template-body">{applyEmailTemplate}</pre>
      </friend-copy-field>
    </article>
  </dialog>
</friend-apply-dialog>

<script is:inline>
  // 一律使用事件委托（监听元素自身），这样自定义元素在子节点解析完成前
  // 触发 connectedCallback 也不会漏绑事件
  if (!customElements.get("friend-apply-trigger")) {
    class FriendApplyTrigger extends HTMLElement {
      constructor() {
        super();
        this.handleClick = this.handleClick.bind(this);
      }

      connectedCallback() {
        this.addEventListener("click", this.handleClick);
      }

      disconnectedCallback() {
        this.removeEventListener("click", this.handleClick);
      }

      handleClick(e) {
        if (!e.target.closest("button")) return;
        document.getElementById("friend-apply-dialog")?.showModal();
      }
    }
    customElements.define("friend-apply-trigger", FriendApplyTrigger);
  }

  if (!customElements.get("friend-apply-dialog")) {
    class FriendApplyDialog extends HTMLElement {
      constructor() {
        super();
        this.handleClick = this.handleClick.bind(this);
      }

      connectedCallback() {
        this.addEventListener("click", this.handleClick);
      }

      disconnectedCallback() {
        this.removeEventListener("click", this.handleClick);
      }

      handleClick(e) {
        const dialog = this.querySelector("dialog");
        if (!dialog) return;

        // 关闭按钮，或点击 dialog 自身（即遮罩区域，面板会拦截自己的点击）
        if (e.target.closest(".friend-apply-close") || e.target === dialog) {
          dialog.close();
        }
      }
    }
    customElements.define("friend-apply-dialog", FriendApplyDialog);
  }
</script>

<style is:global>
  /* ---------- 弹窗外壳 ---------- */
  .friend-apply-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    padding: 0;
    background: transparent;
    width: min(520px, 92vw);
    max-height: 92vh;
    overflow: visible;
  }
  .friend-apply-dialog::backdrop {
    background: rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(6px);
  }
  .friend-apply-dialog[open] .friend-apply-panel {
    animation: friend-apply-pop 0.22s cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  @keyframes friend-apply-pop {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .friend-apply-dialog[open] .friend-apply-panel {
      animation: none;
    }
  }

  /* 磨砂玻璃面板（不使用 card-base，避免其不透明背景覆盖）。
     面板自身即滚动容器，正常情况下内容一屏放得下不会出现滚动条。 */
  .friend-apply-panel {
    max-height: 92vh;
    border-radius: 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.3);
  }
  :root.dark .friend-apply-panel {
    background: rgba(28, 28, 32, 0.82);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.6);
  }
  /* 不支持 backdrop-filter 时退回不透明背景，保证可读性 */
  @supports not (backdrop-filter: blur(1px)) {
    .friend-apply-panel,
    :root.dark .friend-apply-panel {
      background: var(--card-bg);
    }
  }
  /* 左右内边距由各区块自己承担，省掉一层布局包装元素 */
  .friend-apply-panel > :not(.friend-apply-header) {
    margin-left: 1.25rem;
    margin-right: 1.25rem;
  }
  .friend-apply-panel > :last-child {
    margin-bottom: 1.25rem;
  }

  /* ---------- 头部 ---------- */
  .friend-apply-header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: 2.5rem 1fr 2rem;
    column-gap: 0.75rem;
    align-items: center;
    padding: 1rem 1.25rem;
    overflow: hidden;
    border-bottom: 1px solid var(--line-divider);
    background: rgba(255, 255, 255, 0.92);
  }
  :root.dark .friend-apply-header {
    background: rgba(28, 28, 32, 0.92);
  }
  /* 呼应友链页 Hero 的柔光装饰 */
  .friend-apply-header-glow {
    position: absolute;
    top: -5rem;
    right: -3rem;
    width: 12rem;
    height: 12rem;
    border-radius: 9999px;
    background: var(--primary);
    opacity: 0.14;
    filter: blur(46px);
    pointer-events: none;
  }
  .friend-apply-header-icon {
    grid-area: 1 / 1 / 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background-color: color-mix(in oklch, var(--primary) 14%, transparent);
    color: var(--primary);
  }
  .friend-apply-title {
    grid-area: 1 / 2 / 2 / 3;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--deep-text);
  }
  .friend-apply-subtitle {
    grid-area: 2 / 2 / 3 / 3;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--content-meta);
  }
  .friend-apply-close {
    grid-area: 1 / 3 / 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: transparent;
    color: var(--content-meta);
    cursor: pointer;
    /* hover 背景静止时透明，可过渡；文字颜色随主题即时翻转 */
    transition: background-color 0.2s;
  }

  /* ---------- 三步流程（横排） ---------- */
  .friend-apply-steps {
    list-style: none;
    padding: 0;
    margin-top: 1.125rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .friend-apply-step {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    column-gap: 0.5rem;
    row-gap: 0.25rem;
    align-content: start;
    padding: 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--line-divider);
    /* 半透明而非 --card-bg，让面板的磨砂背景透出来 */
    background: rgba(255, 255, 255, 0.5);
  }
  :root.dark .friend-apply-step {
    background: rgba(255, 255, 255, 0.035);
  }
  .friend-apply-step-num {
    grid-area: 1 / 1 / 2 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    background-color: color-mix(in oklch, var(--primary) 15%, transparent);
    color: var(--primary);
  }
  .friend-apply-step-title {
    grid-area: 1 / 2 / 2 / 3;
    align-self: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--deep-text);
  }
  /* 描述横跨整张卡片，窄列里少折行 */
  .friend-apply-step-desc {
    grid-column: 1 / -1;
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--content-meta);
  }

  /* ---------- 区块小标题 ---------- */
  .friend-apply-section {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.125rem;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--deep-text);
  }
  .friend-apply-section > svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  /* ---------- 申请模板 ---------- */
  .friend-apply-field {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 0.625rem;
    padding: 0.5rem 0.5rem 0.5rem 0.75rem;
    border-radius: 0.625rem;
    border: 1px solid var(--line-divider);
    background: color-mix(in oklch, var(--primary) 5%, transparent);
  }
  .friend-apply-field-label {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--content-meta);
  }
  .friend-apply-field-value {
    min-width: 0;
    font-size: 0.82rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .friend-apply-copy {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.375rem;
    cursor: pointer;
    color: var(--btn-content);
    background: rgba(0, 0, 0, 0.08);
    transition: opacity 0.2s;
  }
  :root.dark .friend-apply-copy {
    background: rgba(255, 255, 255, 0.1);
  }
  .friend-apply-copy:hover {
    opacity: 0.8;
  }

  .friend-apply-template {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    margin-top: 0.5rem;
    border-radius: 0.625rem;
    border: 1px solid var(--line-divider);
    background: rgba(0, 0, 0, 0.035);
    overflow: hidden;
  }
  :root.dark .friend-apply-template {
    background: rgba(255, 255, 255, 0.05);
  }
  .friend-apply-template > .friend-apply-field-label {
    padding: 0.4rem 0 0.4rem 0.75rem;
  }
  .friend-apply-template > .friend-apply-copy {
    margin: 0.25rem 0.375rem;
  }
  .friend-apply-template-body {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0.5rem 0.75rem 0.625rem;
    border-top: 1px solid var(--line-divider);
    font-family: inherit;
    font-size: 0.76rem;
    line-height: 1.7;
    white-space: pre;
    overflow-x: auto;
  }

  /* ---------- 窄屏 ---------- */
  @media (max-width: 560px) {
    .friend-apply-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
