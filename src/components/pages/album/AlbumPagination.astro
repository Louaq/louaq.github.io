---
// 相册分页：只有页码按钮。图片的页号由相册页在构建时写到 data-album-page 上，
// 本组件切页时按页号显隐，并用 aria-current 标记当前页（样式随之切换）。
// ponytail: 页码全部平铺不折叠，页数多到一行放不下时再加省略号
import { clientPageNumIdle } from "@/utils/pagination";

interface Props {
	totalPages: number;
}

const { totalPages } = Astro.props;

const pageBtnClass = `${clientPageNumIdle} aria-[current=page]:border-(--primary) aria-[current=page]:bg-(--primary) aria-[current=page]:text-white`;
---

{
	totalPages > 1 && (
		<nav id="album-pagination" class="flex flex-wrap justify-center gap-1.5 py-6" aria-label="Pagination">
			{Array.from({ length: totalPages }, (_, i) => (
				<button
					type="button"
					class={pageBtnClass}
					data-goto={i + 1}
					aria-current={i === 0 ? "page" : undefined}
				>
					{i + 1}
				</button>
			))}
		</nav>
	)
}

{/* 相册页整页加载，脚本只跑一次 */}
<script is:inline>
	(() => {
		const nav = document.getElementById("album-pagination");
		if (!nav) return;
		const grid = document.getElementById("photo-container");

		nav.addEventListener("click", (e) => {
			const btn = e.target.closest("[data-goto]");
			if (!btn || btn.hasAttribute("aria-current")) return;
			const page = btn.dataset.goto;

			for (const b of nav.querySelectorAll("[data-goto]")) {
				if (b === btn) b.setAttribute("aria-current", "page");
				else b.removeAttribute("aria-current");
			}

			// 淡出 → 换页并回到顶部 → 淡入（时长与 grid 的 duration-200 一致）
			grid.style.opacity = "0";
			setTimeout(() => {
				for (const item of grid.querySelectorAll("[data-album-page]")) {
					item.hidden = item.dataset.albumPage !== page;
				}
				window.scrollTo({ top: 0 });
				grid.style.opacity = "";
			}, 200);
		});
	})();
</script>
