---
/**
 * 单栏页面（归档 / 友链 / 观影 / 关于）顶部的标题区。
 *
 * 配色不写死具体颜色，而是围绕站点的 --hue 做角度偏移生成 oklch 渐变，
 * 这样用户在主题设置里改主色调时整块 hero 会跟着一起变，不需要再改这里。
 */
interface Props {
	title: string;
	subtitle?: string;
	/** 额外挂到根节点的 class */
	class?: string;
}

const { title, subtitle, class: className } = Astro.props;

// 标题上方的装饰圆点：[相对 --hue 的色相偏移, 直径 px, 垂直位移 px]
// 色相每颗递进 35°，全部取正值（oklch 的 hue 会自动对 360 取模，290 等价于 -70），
// 避免在 calc() 里出现 `+ -70` 这种形式。垂直位移两端大、中间小，排出一道开口向下的浅弧
const decorDots: Array<[number, number, number]> = [
	[290, 5, 9],
	[325, 6, 3],
	[0, 5, 0],
	[35, 7, -2],
	[70, 5, 0],
	[105, 6, 3],
	[140, 5, 9],
];
---

<section class:list={["page-hero", className]}>
  {/* 细网格底纹由页面背景（<html>）统一绘制，见 MainGridLayout 的 data-white-bg 规则；
     此处不再重复画一层，否则两套网格原点不同会叠出错位的双线 */}
  <div class="page-hero-dots" aria-hidden="true">
    {decorDots.map(([hueShift, size, shiftY], index) => (
      <span
        style={`--dot-hue-shift:${hueShift}; --dot-size:${size}px; --dot-shift-y:${shiftY}px; --dot-delay:${(index * 0.16).toFixed(2)}s;`}
      />
    ))}
  </div>

  {/* 柔光必须是标题的前置兄弟节点而不是 ::before：标题的渐变是画在 background 上
     再用 background-clip:text 裁成字形的，而元素背景的绘制早于任何负 z-index 子节点，
     用 ::before 会把柔光盖在字上。两者都 position 后按 DOM 顺序绘制，标题自然在上层。 */}
  <div class="page-hero-titlewrap">
    <span class="page-hero-glow" aria-hidden="true"></span>
    <h1 class="page-hero-title">{title}</h1>
  </div>

  {subtitle && <p class="page-hero-subtitle">{subtitle}</p>}

  {/* 页面自定义的补充信息（如观影页的「最后更新于」） */}
  <slot />

  <span class="page-hero-mark" aria-hidden="true"></span>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3.5rem 1rem 2.75rem;
    overflow: hidden;
  }

  /* 装饰圆点弧 */
  .page-hero-dots {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .page-hero-dots span {
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: 9999px;
    background: oklch(0.68 0.19 calc(var(--hue) + var(--dot-hue-shift)));
    /* backwards：延迟期间就套用 0% 帧，否则错峰启动的点在等待延迟时会先平躺一下再跳进弧里 */
    animation: page-hero-float-dot 3s ease-in-out infinite backwards;
    animation-delay: var(--dot-delay);
  }

  /* 每颗点的静态弧形位移必须并进关键帧里：动画期间 transform 完全由关键帧接管，
     若这里只写 translateY(-10px)，那道弧就会在动画启动的瞬间被抹平 */
  @keyframes page-hero-float-dot {
    0%,
    100% {
      transform: translateY(var(--dot-shift-y));
      opacity: 0.6;
    }
    50% {
      transform: translateY(calc(var(--dot-shift-y) - 10px));
      opacity: 1;
    }
  }

  :global(.dark) .page-hero-dots span {
    background: oklch(0.75 0.16 calc(var(--hue) + var(--dot-hue-shift)));
  }

  .page-hero-titlewrap {
    position: relative;
    display: inline-flex;
  }

  .page-hero-glow {
    position: absolute;
    top: -1.1rem;
    right: -2.5rem;
    bottom: -1.1rem;
    left: -2.5rem;
    border-radius: 9999px;
    background: linear-gradient(
      100deg,
      oklch(0.62 0.23 calc(var(--hue) + 65)),
      oklch(0.63 0.19 calc(var(--hue) - 45))
    );
    opacity: 0.16;
    filter: blur(30px);
  }

  :global(.dark) .page-hero-glow {
    opacity: 0.24;
  }

  /* 标题：渐变裁进字形 */
  .page-hero-title {
    position: relative;
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.02em;
    background-image: linear-gradient(
      100deg,
      oklch(0.62 0.23 calc(var(--hue) + 65)) 0%,
      oklch(0.55 0.24 var(--hue)) 48%,
      oklch(0.63 0.19 calc(var(--hue) - 45)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  :global(.dark) .page-hero-title {
    background-image: linear-gradient(
      100deg,
      oklch(0.76 0.18 calc(var(--hue) + 65)) 0%,
      oklch(0.72 0.17 var(--hue)) 48%,
      oklch(0.78 0.14 calc(var(--hue) - 45)) 100%
    );
  }

  .page-hero-subtitle {
    margin: 1rem 0 0;
    max-width: 34rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    letter-spacing: 0.06em;
    color: var(--juejin-text-secondary);
  }

  /* 收尾的小圆点，替代一条生硬的分隔线 */
  .page-hero-mark {
    width: 6px;
    height: 6px;
    margin-top: 1.75rem;
    border-radius: 9999px;
    background: var(--primary);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--primary) 14%, transparent);
  }

  @media (max-width: 640px) {
    .page-hero {
      padding: 2.5rem 1rem 2rem;
    }

    .page-hero-subtitle {
      font-size: 0.875rem;
      letter-spacing: 0.04em;
    }
  }
</style>
