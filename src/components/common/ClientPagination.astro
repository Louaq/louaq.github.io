---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
	buildPageItems,
	clientPageNumActive,
	clientPageNumIdle,
	ellipsisClass,
	jumpGroupClass,
	jumpInputClass,
	jumpInputSlotClass,
	jumpShellClass,
} from "@/utils/pagination";

interface Props {
	totalItems: number;
	itemsPerPage: number;
	currentPage: number;
	sectionId: string;
}

const { totalItems, itemsPerPage, currentPage, sectionId } = Astro.props;
const totalPages = Math.ceil(totalItems / itemsPerPage);

const pageItems = buildPageItems(currentPage, totalPages);

const navArrowClass =
	"inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-(--juejin-border) bg-(--juejin-tag-bg) text-(--juejin-text-secondary) hover:bg-(--btn-plain-bg-hover) disabled:cursor-not-allowed disabled:opacity-50";
const jumpSubmitClass =
	"inline-flex h-9 shrink-0 items-center justify-center border-l border-(--juejin-border) bg-(--juejin-tag-bg) px-2 text-(--primary) hover:bg-(--btn-plain-bg-hover) disabled:cursor-not-allowed disabled:opacity-50";

const jumpInvalidMsg = i18n(I18nKey.paginationJumpInvalid);
---

{
	totalPages > 1 && (
		<div
			class="responsive-pagination mt-6 flex w-full max-w-full flex-col gap-1"
			data-pagination-section={sectionId}
			data-items-per-page={itemsPerPage}
			data-initial-page={currentPage}
			data-jump-invalid-msg={jumpInvalidMsg}
			data-page-label={i18n(I18nKey.paginationPage)}
		>
			<nav
				class="pagination-reflow flex w-full max-w-full flex-row items-center gap-2 sm:gap-3"
				aria-label="Pagination"
			>
				<div class="flex w-9 shrink-0 justify-start sm:w-10">
					<button
						type="button"
						class={navArrowClass}
						data-page="prev"
						data-section={sectionId}
						disabled={currentPage === 1}
						aria-label={i18n(I18nKey.paginationPrev)}
					>
						<Icon
							name="material-symbols:chevron-left"
							class="text-[1.25rem] leading-none sm:text-[1.35rem]"
						/>
					</button>
				</div>

				<div
					class="flex min-w-0 flex-1 flex-wrap items-center justify-center gap-1.5"
					data-page-numbers
				>
					{pageItems.map((item) =>
						item.kind === "ellipsis" ? (
							<span class={ellipsisClass} aria-hidden="true">
								…
							</span>
						) : item.num === currentPage ? (
							<span
								class={clientPageNumActive}
								aria-current="page"
								aria-label={`${i18n(I18nKey.paginationPage)} ${item.num}`}
							>
								{item.num}
							</span>
						) : (
							<button
								type="button"
								class:list={[clientPageNumIdle, "pagination-page-btn"]}
								data-page-num={item.num}
								aria-label={`${i18n(I18nKey.paginationPage)} ${item.num}`}
							>
								{item.num}
							</button>
						),
					)}

					<div class={jumpGroupClass} data-pagination-jump-shell>
						<div class={jumpShellClass}>
							<div class={jumpInputSlotClass}>
								<input
									type="text"
									inputmode="numeric"
									pattern="[0-9]*"
									autocomplete="off"
									enterkeyhint="go"
									maxlength={Math.max(1, String(totalPages).length)}
									class={jumpInputClass}
									data-pagination-jump-input
									aria-label={`${i18n(I18nKey.paginationJumpTo)}${i18n(I18nKey.paginationJumpPageUnit)}`}
								/>
							</div>
							<button
								type="button"
								class={jumpSubmitClass}
								data-pagination-jump-go
								disabled={totalPages <= 1}
								aria-label={i18n(I18nKey.paginationGo)}
							>
								<Icon
									name="material-symbols:keyboard-double-arrow-right-rounded"
									class="text-[1.125rem] sm:text-[1.25rem]"
								/>
							</button>
						</div>
					</div>
				</div>

				<div class="flex w-9 shrink-0 justify-end sm:w-10">
					<button
						type="button"
						class={navArrowClass}
						data-page="next"
						data-section={sectionId}
						disabled={currentPage === totalPages}
						aria-label={i18n(I18nKey.paginationNext)}
					>
						<Icon
							name="material-symbols:chevron-right"
							class="text-[1.25rem] leading-none sm:text-[1.35rem]"
						/>
					</button>
				</div>
			</nav>

			<p
				data-pagination-jump-error
				class="hidden w-full px-2 text-center text-sm text-red-600 dark:text-red-400"
				role="alert"
				aria-live="polite"
			/>
		</div>
	)
}

<script>
	import {
		buildPageItems,
		clientPageNumActive,
		clientPageNumIdle,
		ellipsisClass,
	} from "@/utils/pagination";

	function isCoarsePointer() {
		return window.matchMedia("(hover: none), (pointer: coarse)").matches;
	}
	function ensureJumpTouchOutsideClose() {
		if (window.__fireflyJumpTouchOutside) return;
		window.__fireflyJumpTouchOutside = true;
		document.addEventListener("click", function (e) {
			if (!isCoarsePointer()) return;
			const t = e.target;
			if (!(t instanceof Node)) return;
			document
				.querySelectorAll(".pagination-jump-group.jump-touch-expanded")
				.forEach((g) => {
					if (g instanceof HTMLElement && !g.contains(t)) {
						g.classList.remove("jump-touch-expanded");
					}
				});
		});
	}

	function initPagination(pagination: HTMLElement) {
		// 首屏加载与 astro:page-load 都会调用；swup 换页后是新元素，标记不会残留
		if (pagination.dataset.paginationBound) return;
		pagination.dataset.paginationBound = "true";

		const sectionId = pagination.dataset.paginationSection as string;
		const itemsPerPage = Number(pagination.dataset.itemsPerPage);
		const jumpInvalidMsg = pagination.dataset.jumpInvalidMsg as string;
		const pageLabel = pagination.dataset.pageLabel as string;
		let currentPage = Number(pagination.dataset.initialPage);
		let isInitialLoad = true;

		const pageHost = pagination.querySelector(
			"[data-page-numbers]",
		) as HTMLElement;
		const jumpShell = pageHost.querySelector(
			"[data-pagination-jump-shell]",
		) as HTMLElement;
		const jumpGoBtn = pagination.querySelector(
			"[data-pagination-jump-go]",
		) as HTMLButtonElement;
		const jumpInput = pagination.querySelector(
			"[data-pagination-jump-input]",
		) as HTMLInputElement;
		const errEl = pagination.querySelector(
			"[data-pagination-jump-error]",
		) as HTMLElement;

		const getItems = () =>
			document.querySelectorAll<HTMLElement>(
				`[data-item-section="${sectionId}"]:not(.hidden)`,
			);

		ensureJumpTouchOutsideClose();
		jumpShell.addEventListener("click", function (e) {
			if (!isCoarsePointer()) return;
			if (jumpShell.classList.contains("jump-touch-expanded")) return;
			const t = e.target;
			if (t instanceof Node && jumpGoBtn.contains(t)) return;
			jumpShell.classList.add("jump-touch-expanded");
			jumpInput.focus();
		});

		function rebuildPageNumberControls(totalPages: number) {
			const frag = document.createDocumentFragment();
			for (const it of buildPageItems(currentPage, totalPages)) {
				if (it.kind === "ellipsis") {
					const span = document.createElement("span");
					span.className = ellipsisClass;
					span.setAttribute("aria-hidden", "true");
					span.textContent = "…";
					frag.appendChild(span);
				} else if (it.num === currentPage) {
					const span = document.createElement("span");
					span.className = clientPageNumActive;
					span.setAttribute("aria-current", "page");
					span.setAttribute("aria-label", `${pageLabel} ${it.num}`);
					span.textContent = String(it.num);
					frag.appendChild(span);
				} else {
					const button = document.createElement("button");
					button.type = "button";
					button.className = `${clientPageNumIdle} pagination-page-btn`;
					button.dataset.pageNum = String(it.num);
					button.setAttribute("aria-label", `${pageLabel} ${it.num}`);
					button.textContent = String(it.num);
					frag.appendChild(button);
				}
			}
			while (pageHost.firstChild && pageHost.firstChild !== jumpShell) {
				pageHost.removeChild(pageHost.firstChild);
			}
			pageHost.insertBefore(frag, jumpShell);
		}

		function hideJumpError() {
			errEl.textContent = "";
			errEl.classList.add("hidden");
			jumpInput.removeAttribute("aria-invalid");
		}

		function showJumpError() {
			errEl.textContent = jumpInvalidMsg;
			errEl.classList.remove("hidden");
			jumpInput.setAttribute("aria-invalid", "true");
		}

		function setNavDisabled(totalPages: number) {
			const tp = Math.max(1, totalPages);
			pagination
				.querySelectorAll<HTMLButtonElement>('[data-page="prev"]')
				.forEach((btn) => {
					btn.disabled = currentPage === 1;
				});
			pagination
				.querySelectorAll<HTMLButtonElement>('[data-page="next"]')
				.forEach((btn) => {
					btn.disabled = currentPage === tp;
				});
			jumpGoBtn.disabled = tp <= 1;
			jumpInput.maxLength = Math.max(1, String(tp).length);
		}

		function applyJump() {
			hideJumpError();
			const v = String(jumpInput.value).trim();
			if (v === "" || !/^\d+$/.test(v)) {
				showJumpError();
				return;
			}
			const tp = Math.max(1, Math.ceil(getItems().length / itemsPerPage));
			currentPage = Math.min(tp, Math.max(1, parseInt(v, 10)));
			jumpInput.value = "";
			updatePage();
		}

		pageHost.addEventListener("click", function (e) {
			const target = e.target;
			if (!(target instanceof Element)) return;
			const btn = target.closest("[data-page-num]");
			if (!(btn instanceof HTMLButtonElement)) return;
			currentPage = parseInt(btn.dataset.pageNum as string, 10);
			updatePage();
		});

		jumpGoBtn.addEventListener("click", function () {
			if (
				isCoarsePointer() &&
				!jumpShell.classList.contains("jump-touch-expanded")
			) {
				jumpShell.classList.add("jump-touch-expanded");
				jumpInput.focus();
				return;
			}
			applyJump();
		});
		jumpInput.addEventListener("keydown", function (e) {
			if (e.key === "Enter") {
				e.preventDefault();
				applyJump();
			}
		});
		jumpInput.addEventListener("input", hideJumpError);

		pagination
			.querySelectorAll<HTMLButtonElement>("[data-page]")
			.forEach((button) => {
				button.addEventListener("click", function () {
					if (button.dataset.page === "prev") {
						currentPage = Math.max(1, currentPage - 1);
					} else {
						const totalPages = Math.ceil(getItems().length / itemsPerPage);
						currentPage = Math.min(Math.max(1, totalPages), currentPage + 1);
					}
					updatePage();
				});
			});

		function updatePage() {
			const items = getItems();
			const totalPages = Math.ceil(items.length / itemsPerPage);

			if (currentPage > totalPages && totalPages > 0) {
				currentPage = totalPages;
			}

			const startIndex = (currentPage - 1) * itemsPerPage;
			const endIndex = startIndex + itemsPerPage;

			const applyVisibility = () => {
				for (const item of items) {
					item.style.display = "none";
				}
				for (let i = startIndex; i < endIndex && i < items.length; i++) {
					items[i].style.display = "block";
					items[i].style.opacity = "1";
				}
				rebuildPageNumberControls(Math.max(1, totalPages));
				setNavDisabled(totalPages);
			};

			if (isInitialLoad) {
				isInitialLoad = false;
				applyVisibility();
			} else {
				for (const item of items) {
					if (item.style.display !== "none") {
						item.style.opacity = "0";
					}
				}
				setTimeout(applyVisibility, 200);
			}
		}

		updatePage();
	}

	function initAll() {
		document
			.querySelectorAll<HTMLElement>("[data-pagination-section]")
			.forEach(initPagination);
	}

	initAll();
	document.addEventListener("astro:page-load", initAll);
</script>

<style>
	.responsive-pagination {
		max-width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}
	.pagination-reflow {
		flex-wrap: wrap;
		row-gap: 0.5rem;
	}
	@media (min-width: 480px) {
		.pagination-reflow {
			flex-wrap: nowrap;
		}
	}
	.pagination-jump-group.jump-touch-expanded .jump-input-slot {
		max-width: 3rem;
		opacity: 1;
	}
</style>
