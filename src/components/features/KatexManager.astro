---
import { url } from "@/utils/url-utils";

// KaTeX 样式自托管到 public/katex（构建期不再 import，避免 Astro 把其 CSS
// 提升为全站渲染阻塞的 <link>）。仅在含公式的页面运行时注入一次。
const katexCssHref = url("/katex/katex.min.css");
---
<script is:inline define:vars={{ katexCssHref }}>
    // KaTeX 样式按需加载：仅当页面存在公式时才注入一次 <link>
    function loadKatex() {
        if (document.querySelector('.katex') && !document.getElementById('katex-css')) {
            const link = document.createElement('link');
            link.id = 'katex-css';
            link.rel = 'stylesheet';
            link.href = katexCssHref;
            document.head.appendChild(link);
        }
    }

    // 本组件随 Markdown 正文出现；swup 导航后 scripts 插件会重新执行内联脚本
    loadKatex();
</script>
