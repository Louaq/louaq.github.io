---
import CoverImage from "@/components/common/CoverImage.astro";

export interface CarouselSlide {
	href: string;
	title: string;
	image: string;
	basePath?: string;
	openInNewTab?: boolean;
	category?: string | null;
	description?: string;
	date?: string;
}

interface Props {
	slides: CarouselSlide[];
	autoplayMs?: number;
}

const { slides, autoplayMs = 5000 } = Astro.props;
const safeAutoplayMs = Math.max(0, autoplayMs);
---

{
	slides.length > 0 && (
		<section
			class="home-carousel onload-animation mb-4"
			data-home-carousel
			data-autoplay={safeAutoplayMs}
			aria-label="首页精选轮播"
		>
			<div class="carousel-track-wrap card-base rounded-(--radius-large) relative overflow-hidden">
				<div class="carousel-track flex">
					{
						slides.map((slide, index) => {
							const finalImage = slide.image?.trim() || "";
							const hasImage = !!finalImage;
							const isExternal =
								slide.openInNewTab ??
								(/^https?:\/\//.test(slide.href) || slide.href.startsWith("//"));
							return (
								<article class="carousel-slide min-w-full">
									<a
										href={slide.href}
										class="carousel-slide-link group relative block h-[230px] md:h-[300px]"
										target={isExternal ? "_blank" : undefined}
										rel={isExternal ? "noopener noreferrer" : undefined}
									>
										{
											hasImage ? (
												<div class="carousel-media absolute inset-0">
													<CoverImage
														src={finalImage}
														basePath={slide.basePath || "/"}
														alt={slide.title}
														class="h-full w-full object-cover"
														preview={true}
														loading={index === 0 ? "eager" : "lazy"}
														deferSrc={index > 0}
													/>
												</div>
											) : (
												<div class="carousel-fallback absolute inset-0" />
											)
										}
										<div class="carousel-mask absolute inset-0" />
										<div class="carousel-content absolute inset-0 p-4 md:p-6">
											{slide.category && (
												<span class="carousel-category rounded-full px-3 py-1 text-xs font-bold text-white mb-3">
													{slide.category}
												</span>
											)}
											<h2 class="text-xl md:text-2xl font-bold leading-snug line-clamp-2 text-white">
												{slide.title}
											</h2>
											{slide.description && (
												<p class="text-sm text-white/85 mt-2 line-clamp-1">{slide.description}</p>
											)}
											{slide.date && <time class="text-xs text-white/70 mt-4">{slide.date}</time>}
										</div>
									</a>
								</article>
							);
						})
					}
				</div>
			</div>
			{
				slides.length > 1 && (
					<div class="carousel-dots flex justify-center gap-2 mt-3">
						{
							slides.map((_slide, index) => (
								<button
									type="button"
									class="carousel-dot h-1.5 rounded-full"
									data-slide-to={index}
									aria-label={`跳转到第 ${index + 1} 张`}
								/>
							))
						}
					</div>
				)
			}
		</section>
	)
}

<script is:inline data-astro-rerun>
	function setupCarousel(root) {
		const track = root.querySelector(".carousel-track");
		if (!track) return;
		const slides = Array.from(root.querySelectorAll(".carousel-slide"));
		const total = slides.length;
		if (total === 0) return;

		const dots = Array.from(root.querySelectorAll(".carousel-dot"));
		const autoplayMs = Number(root.getAttribute("data-autoplay") || "0");

		let current = 0;
		let timer = null;
		let touchStartX = 0;
		let touchStartY = 0;
		let touchTracking = false;

		const loadSlideImage = (index) => {
			const slide = slides[index];
			if (!slide) return;
			const image = slide.querySelector("img[data-lazy-src]");
			if (!image) return;
			const lazySrc = image.getAttribute("data-lazy-src");
			if (!lazySrc) return;
			image.setAttribute("src", lazySrc);
			image.removeAttribute("data-lazy-src");
		};

		const render = () => {
			loadSlideImage(current);
			slides.forEach((slide, i) => {
				slide.classList.toggle("is-active", i === current);
			});
			dots.forEach((dot, i) => {
				dot.classList.toggle("is-active", i === current);
			});
		};

		const stop = () => {
			if (timer) {
				clearInterval(timer);
				timer = null;
			}
		};

		const start = () => {
			stop();
			if (autoplayMs > 0 && total > 1) {
				timer = setInterval(() => {
					current = (current + 1) % total;
					render();
				}, autoplayMs);
			}
		};

		const goTo = (index) => {
			if (total <= 1) return;
			current = (index + total) % total;
			render();
			start();
		};

		dots.forEach((dot, i) => {
			dot.addEventListener("click", () => {
				goTo(i);
			});
		});

		root.addEventListener("mouseenter", stop);
		root.addEventListener("mouseleave", start);

		root.addEventListener(
			"touchstart",
			(event) => {
				if (total <= 1) return;
				const touch = event.touches[0];
				if (!touch) return;
				touchStartX = touch.clientX;
				touchStartY = touch.clientY;
				touchTracking = true;
				stop();
			},
			{ passive: true },
		);

		root.addEventListener(
			"touchend",
			(event) => {
				if (!touchTracking || total <= 1) return;
				touchTracking = false;
				const touch = event.changedTouches[0];
				if (!touch) {
					start();
					return;
				}
				const deltaX = touch.clientX - touchStartX;
				const deltaY = touch.clientY - touchStartY;
				const isHorizontalSwipe = Math.abs(deltaX) > 48 && Math.abs(deltaX) > Math.abs(deltaY) * 1.2;
				if (isHorizontalSwipe) {
					goTo(deltaX < 0 ? current + 1 : current - 1);
				} else {
					start();
				}
			},
			{ passive: true },
		);

		root.addEventListener("touchcancel", () => {
			touchTracking = false;
			start();
		});

		render();
		start();
	}

	function initHomeCarousel() {
		document.querySelectorAll("[data-home-carousel]").forEach((carousel) => {
			const el = carousel;
			if (el.dataset.inited === "true") return;
			el.dataset.inited = "true";
			setupCarousel(el);
		});
	}

	// is:inline 脚本位于轮播结构之后，swup 换页时由 Layout 重跑，直接初始化即可
	initHomeCarousel();
</script>

<style>
	.home-carousel .carousel-track {
		position: relative;
		height: 230px;
	}

	.home-carousel .carousel-track-wrap {
		overflow: hidden;
		background: color-mix(in oklab, var(--card-bg) 82%, black 18%);
		touch-action: pan-y;
	}

	.home-carousel .carousel-slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.55s ease;
	}

	.home-carousel .carousel-slide.is-active {
		opacity: 1;
		pointer-events: auto;
	}

	.home-carousel .carousel-slide-link {
		border-radius: var(--radius-large);
		overflow: hidden;
	}

	.home-carousel .carousel-fallback {
		background:
			radial-gradient(circle at 20% 10%, color-mix(in oklab, var(--primary) 35%, transparent 65%) 0%, transparent 45%),
			radial-gradient(circle at 80% 85%, color-mix(in oklab, var(--primary) 25%, transparent 75%) 0%, transparent 35%),
			var(--card-bg);
	}

	.home-carousel .carousel-mask {
		background:
			linear-gradient(
				180deg,
				rgba(0, 0, 0, 0.12) 0%,
				rgba(0, 0, 0, 0.38) 50%,
				rgba(0, 0, 0, 0.7) 100%
			);
	}

	.home-carousel .carousel-content {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		align-items: flex-start;
		min-height: 100%;
		padding-left: 3.2rem;
		padding-right: 3.2rem;
		padding-bottom: 1.5rem;
		text-align: left;
	}

	.home-carousel .carousel-category {
		background: rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(6px);
	}

	.home-carousel .carousel-dot {
		width: 1.5rem;
		background: var(--btn-regular-bg-active);
		transition: width 0.2s ease, background 0.2s ease;
	}

	.home-carousel .carousel-dot.is-active {
		width: 2.5rem;
		background: var(--primary);
	}

	@media (max-width: 768px) {
		.home-carousel .carousel-content {
			padding-left: 2.2rem;
			padding-right: 2.2rem;
			padding-bottom: 1.5rem;
		}
	}

	@media (min-width: 768px) {
		.home-carousel .carousel-track {
			height: 300px;
		}
	}
</style>
