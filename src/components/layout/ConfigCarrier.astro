---
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
---

<!-- 全局配置载体 -->
<!--
  data-toc-empty：TOC 空状态文案。tocUtils 是客户端模块，直接 import
  `@i18n/translation` 会把含 5 种语言的 ~44KB chunk 拖进每个页面的首屏 JS，
  所以这一个字符串改由服务端渲染进 DOM。
-->
<div
  id="config-carrier"
  data-hue={siteConfig.themeColor.hue}
  data-toc-empty={i18n(I18nKey.tocEmpty)}
>
</div>
