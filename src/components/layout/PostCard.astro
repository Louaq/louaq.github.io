---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import RandomCoverImage from "@/components/common/RandomCoverImage.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getCategoryUrl } from "@/utils/category-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { stableIndex } from "@/utils/hash";
import { processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath } from "@/utils/url-utils";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	pinned?: boolean;
	style: string;
	index?: number;
}
const {
	entry,
	title,
	url,
	published,
	category,
	image,
	description,
	pinned,
	style,
	index = 0,
} = Astro.props;
const className = Astro.props.class;
const isEven = index % 2 === 0;
const coverLoading = index === 0 ? "eager" : "lazy";

const { remarkPluginFrontmatter } = await render(entry);
const minutes = remarkPluginFrontmatter.minutes as number | undefined;

// 兜底封面图池：既无显式封面、正文中也没有图片时，从中稳定随机选取一张
const FALLBACK_COVERS = [
	"https://pic1.imgdb.cn/i/0343OVOk1840RU3QCw2YqY.webp",
	"https://pic1.imgdb.cn/i/0343OUzfJ5kPLCCisc71md.webp",
	"https://pic1.imgdb.cn/i/0343OVoaybimn5t3S6sN1R.webp",
	"https://pic1.imgdb.cn/i/0343OV7iV4TrC16ULozyAu.webp",
	"https://pic1.imgdb.cn/i/0343OUwmutCQr7iUB84vHI.webp",
	"https://pic1.imgdb.cn/i/0343OUy8SYeqwZ2NDQOTP1.webp",
	"https://pic1.imgdb.cn/i/0343OV0tF8SlTyf2uOvbEL.webp",
	"https://pic1.imgdb.cn/i/0343OV2Rwaw5mP6Ve5VeUA.webp",
	"https://pic1.imgdb.cn/i/0343OV3oSaEtBNrFHu7RSg.webp",
	"https://pic1.imgdb.cn/i/0343OV5LazhA2ZQlFgJgUl.webp",
	"https://pic1.imgdb.cn/i/0343OV6Tad7dev2XGQJCTa.webp",
	"https://pic1.imgdb.cn/i/0343OUvYUW5GD2L413uo4Z.webp",
];

// 基于文章 id 的稳定哈希，确保同一篇文章每次都选到同一张兜底图
const pickFallbackCover = (seed: string) =>
	FALLBACK_COVERS[stableIndex(seed, FALLBACK_COVERS.length)];

// 处理随机图：如果image为"api"，则从配置的API获取随机图
// 未显式设置封面时，依次回退到正文中第一张图片、再到随机兜底封面图
const firstImage =
	(remarkPluginFrontmatter.firstImage as string | undefined) ?? "";
const processedImage =
	processCoverImageSync(image, entry.id) ||
	firstImage ||
	pickFallbackCover(entry.id);
const basePath = getFileDirFromPath(entry.filePath || "");
const minuteLabel =
	minutes === 1 ? i18n(I18nKey.minuteCount) : i18n(I18nKey.minutesCount);
---

<div
  class:list={[
    "post-card-wrapper hero-card has-cover",
    isEven ? "hero-card--even" : "hero-card--odd",
    pinned ? "pinned" : "",
    "card-base flex w-full overflow-hidden rounded-(--radius-large) cursor-pointer",
    className,
  ]}
  style={style}
  data-url={url}
  role="link"
  tabindex="0"
  aria-label={title}
>
  <!-- 左侧封面图（偶数项） -->
  {
    isEven && (
      <div class="hero-card-side hidden sm:block relative min-w-[45%] overflow-hidden z-10">
        <RandomCoverImage
          src={processedImage}
          basePath={basePath}
          alt=""
          class="hero-card-side-img h-full w-full"
          seed={entry.id}
          preview={true}
          loading={coverLoading}
        />
      </div>
    )
  }

  <!-- content -->
  <div class="hero-card-content relative z-20 w-full sm:w-[65%] flex flex-col justify-between h-full pt-9 pb-5 px-5 sm:px-8">
    <a
      href={url}
      class="hero-card-title my-1 font-bold text-lg md:text-xl line-clamp-1 text-center sm:text-left"
    >
      {title}
    </a>

    <div class="hero-card-desc text-sm line-clamp-2 xl:line-clamp-3 text-center sm:text-left">
      {description || remarkPluginFrontmatter.excerpt}
    </div>

    <div
      class:list={[
        "hero-card-meta inline-flex flex-wrap items-center justify-center",
        isEven ? "sm:justify-end" : "sm:justify-start",
      ]}
    >
      <span class="hero-card-meta-item inline-flex items-center gap-1.5 text-xs">
        <Icon name="fa6-regular:calendar" class="hero-card-meta-icon size-3.5 shrink-0" />
        <span class="whitespace-nowrap">{formatDateToYYYYMMDD(published)}</span>
      </span>
      {minutes != null && (
        <Fragment>
          <span class="hero-card-meta-divider mx-2 h-3 w-px shrink-0" aria-hidden="true" />
          <span class="hero-card-meta-item inline-flex items-center gap-1.5 text-xs">
            <Icon name="material-symbols:schedule-outline-rounded" class="hero-card-meta-icon size-3.5 shrink-0" />
            <span class="whitespace-nowrap">{minutes} {minuteLabel}</span>
          </span>
        </Fragment>
      )}
      {category && (
        <Fragment>
          <span class="hero-card-meta-divider mx-2 h-3 w-px shrink-0" aria-hidden="true" />
          <a
            href={getCategoryUrl(category)}
            aria-label={`View all posts in the ${category} category`}
            class="hero-card-meta-item inline-flex items-center text-xs whitespace-nowrap"
          >
            {category}
          </a>
        </Fragment>
      )}
    </div>
  </div>

  <!-- 右侧封面图（奇数项） -->
  {
    !isEven && (
      <div class="hero-card-side hidden sm:block relative min-w-[45%] overflow-hidden z-10">
        <RandomCoverImage
          src={processedImage}
          basePath={basePath}
          alt=""
          class="hero-card-side-img h-full w-full"
          seed={entry.id}
          preview={true}
          loading={coverLoading}
        />
      </div>
    )
  }

  <!-- pinned ribbon -->
  {
    pinned && (
      <div class="hero-card-pin absolute top-2 left-2 z-30 flex items-center gap-1 rounded-md px-2 py-0.5 font-bold bg-gradient-to-r from-orange-500 to-red-500 text-white shadow-sm shadow-orange-500/30">
        <Icon name="material-symbols:pinboard" class="text-base" />
        <span class="text-xs">{i18n(I18nKey.pinned)}</span>
      </div>
    )
  }

  <!-- password lock -->
  {
    entry.data.password && (
      <div
        class="hero-card-lock absolute top-2 right-2 z-30 flex items-center justify-center size-6 rounded-full bg-black/40 backdrop-blur-sm text-white"
        aria-label="加密"
      >
        <Icon name="material-symbols:lock-outline" class="text-base" />
      </div>
    )
  }
</div>


<style is:global>
  /* =============================================================
   * Hero 文章卡片（参考 ThriveX-Blog ArticleLayout/Classics）：
   * 封面图左右交替出现（斜切裁边）+ 文字区落在半透明卡片底色上
   * ============================================================= */
  .post-card-wrapper.hero-card {
    height: 190px;
    background: var(--card-bg-transparent);
    position: relative;
  }

  /* hero 卡片悬浮时不做任何外观变化：
     需盖过 main.css 的 `.card-base:hover`(阴影) 与
     `#post-list-container.list-mode .post-card-wrapper:hover`(底色/描边，特异性 1,3,0)，
     因此这里用 (1,4,0) 的选择器。 */
  .post-card-wrapper.hero-card.card-base,
  .post-card-wrapper.hero-card.card-base:hover,
  #post-list-container .post-card-wrapper.hero-card.card-base:hover {
    background: var(--card-bg-transparent) !important;
    border-color: transparent !important;
    box-shadow: none !important;
  }

  /* 底色由深色实心改为半透明卡片色后，原先硬编码的白字会看不见，
     这里统一改用随主题走的字色变量。 */
  .hero-card-title {
    color: var(--juejin-text-primary);
  }
  .hero-card-desc,
  .hero-card-meta-item {
    color: var(--juejin-text-secondary);
  }
  .hero-card-meta-icon {
    color: var(--juejin-text-secondary);
    opacity: 0.75;
  }
  .hero-card-meta-divider {
    background: var(--line-divider);
  }
  a.hero-card-meta-item:hover {
    color: var(--primary);
  }

  @media (min-width: 768px) {
    .post-card-wrapper.hero-card {
      height: 15rem;
    }
  }
  @media (min-width: 1024px) {
    .post-card-wrapper.hero-card {
      height: 13rem;
    }
  }
  @media (min-width: 1280px) {
    .post-card-wrapper.hero-card {
      height: 15rem;
    }
  }

  .hero-card-side-img,
  .hero-card-side-img img {
    display: block;
  }

  .hero-card-side-img img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .hero-card--even .hero-card-side {
    clip-path: polygon(0 0, 100% 0, 90% 100%, 0 100%);
  }
  .hero-card--odd .hero-card-side {
    clip-path: polygon(10% 0, 100% 0, 100% 100%, 0 100%);
  }

  .hero-card-title:hover {
    color: var(--primary) !important;
  }

  /* grid-mode 下：覆盖旧规则强加的 1:1 方形、column-reverse 与固定行方向（固定高度已保证等高） */
  #post-list-container.grid-mode .post-card-wrapper.hero-card,
  #post-list-container.grid-mode .post-card-wrapper.hero-card.has-cover {
    aspect-ratio: auto !important;
    flex-direction: row !important;
    height: 190px !important;
  }
  @media (min-width: 768px) {
    #post-list-container.grid-mode .post-card-wrapper.hero-card,
    #post-list-container.grid-mode .post-card-wrapper.hero-card.has-cover {
      height: 15rem !important;
    }
  }

  /* 覆盖旧 list-mode 规则：不再降级为紧凑白色行 */
  @media (min-width: 768px) {
    #post-list-container.list-mode .post-card-wrapper.hero-card {
      background: var(--card-bg-transparent) !important;
      border: none !important;
      border-bottom: none !important;
      border-radius: var(--radius-large) !important;
      box-shadow: none !important;
      flex-direction: row !important;
      height: 15rem !important;
    }
    :root.dark #post-list-container.list-mode .post-card-wrapper.hero-card {
      border-bottom: none !important;
    }
    #post-list-container.list-mode .post-card-wrapper.hero-card:hover {
      box-shadow: none !important;
    }
    #post-list-container.list-mode .post-card-wrapper.hero-card:last-child {
      border-bottom: none !important;
    }
  }

  /* 覆盖旧"单一大白卡+紧贴行"外壳：hero 卡片之间恢复正常间距 */
  #post-list-container.list-mode:has(.hero-card) {
    gap: 1rem !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
  @media (min-width: 768px) {
    #post-list-container.list-mode:has(.hero-card) {
      gap: 1rem !important;
    }
  }
</style>
