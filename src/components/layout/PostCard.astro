---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getCategoryUrl } from "@/utils/category-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getPostRenderMetadata } from "@/utils/post-render-metadata";
import { getFileDirFromPath, getTagUrl } from "@/utils/url-utils";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	pinned?: boolean;
	style: string;
	index?: number;
}
const {
	entry,
	title,
	url,
	published,
	category,
	tags,
	image,
	description,
	pinned,
	style,
	index = 0,
} = Astro.props;
const className = Astro.props.class;
const coverLoading = index === 0 ? "eager" : "lazy";

const remarkPluginFrontmatter = await getPostRenderMetadata(entry);
const minutes = remarkPluginFrontmatter.minutes as number | undefined;
const basePath = getFileDirFromPath(entry.filePath || "");
const minuteLabel =
	minutes === 1 ? i18n(I18nKey.minuteCount) : i18n(I18nKey.minutesCount);
const words = remarkPluginFrontmatter.words as number | undefined;
const wordLabel =
	words === 1 ? i18n(I18nKey.wordCount) : i18n(I18nKey.wordsCount);
---

<div
  class:list={[
    "post-card-wrapper hero-card",
    image ? "has-cover" : "",
    pinned ? "pinned" : "",
    "card-base flex w-full overflow-hidden rounded-(--radius-large) cursor-pointer",
    className,
  ]}
  style={style}
  data-url={url}
  role="link"
  tabindex="0"
  aria-label={title}
>
  <!-- content -->
  <div class="hero-card-content relative z-20 w-full flex flex-col justify-between h-full pt-9 pb-5 px-5 sm:px-8">
    <a
      href={url}
      class="hero-card-title my-1 font-bold text-lg md:text-xl line-clamp-1 text-center sm:text-left"
    >
      {title}
    </a>

    <div class="hero-card-meta flex flex-nowrap items-center gap-4 overflow-hidden justify-center sm:justify-start">
      <span class="hero-card-meta-item inline-flex items-center gap-2 text-xs whitespace-nowrap">
        <span class="hero-card-meta-icon-box"><Icon name="fa6-regular:calendar" class="hero-card-meta-icon size-3.5" /></span>
        {formatDateToYYYYMMDD(published)}
      </span>
      {category && (
        <a
          href={getCategoryUrl(category)}
          aria-label={`View all posts in the ${category} category`}
          class="hero-card-meta-item inline-flex items-center gap-2 text-xs whitespace-nowrap"
        >
          <span class="hero-card-meta-icon-box"><Icon name="material-symbols:book-2-outline-rounded" class="hero-card-meta-icon size-3.5" /></span>
          {category}
        </a>
      )}
      {words != null && (
        <span class="hero-card-meta-item inline-flex items-center gap-2 text-xs whitespace-nowrap">
          <span class="hero-card-meta-icon-box"><Icon name="material-symbols:article-outline-rounded" class="hero-card-meta-icon size-3.5" /></span>
          {words} {wordLabel}
        </span>
      )}
      {minutes != null && (
        <span class="hero-card-meta-item inline-flex items-center gap-2 text-xs whitespace-nowrap">
          <span class="hero-card-meta-icon-box"><Icon name="material-symbols:schedule-outline-rounded" class="hero-card-meta-icon size-3.5" /></span>
          {minutes} {minuteLabel}
        </span>
      )}
    </div>

    <div class="hero-card-desc text-sm line-clamp-1 md:line-clamp-2 xl:line-clamp-3 text-center sm:text-left">
      {description || remarkPluginFrontmatter.excerpt}
    </div>

    {tags.length > 0 && (
      <div class="hero-card-tags flex flex-nowrap gap-2 overflow-hidden justify-center sm:justify-start">
        {tags.map((tag) => (
          <a
            href={getTagUrl(tag)}
            aria-label={`View all posts with the ${tag.trim()} tag`}
            class="hero-card-tag shrink-0 rounded-md px-2 py-0.5 text-xs whitespace-nowrap bg-(--btn-regular-bg)"
          >
            # {tag.trim()}
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- 右侧封面图 -->
  {
    image && (
      <div class="hero-card-side hidden sm:block relative w-[30%] shrink-0 my-3 mr-3 rounded-(--radius-large) overflow-hidden z-10">
        <CoverImage
          src={image}
          basePath={basePath}
          alt=""
          class="hero-card-side-img h-full w-full"
          preview={true}
          loading={coverLoading}
        />
      </div>
    )
  }

  <!-- 无封面时右侧的进入指示 -->
  {
    !image && (
      <div class="hidden sm:flex items-center justify-center w-14 shrink-0 my-3 mr-3 rounded-(--radius-large) bg-(--btn-regular-bg) hover:bg-(--btn-regular-bg-hover) text-(--primary)" aria-hidden="true">
        <Icon name="material-symbols:chevron-right" class="text-3xl" />
      </div>
    )
  }

  <!-- pinned ribbon -->
  {
    pinned && (
      <div class="hero-card-pin absolute top-2 left-2 z-30 flex items-center gap-1 rounded-md px-2 py-0.5 font-bold bg-gradient-to-r from-orange-500 to-red-500 text-white shadow-sm shadow-orange-500/30">
        <Icon name="material-symbols:pinboard" class="text-base" />
        <span class="text-xs">{i18n(I18nKey.pinned)}</span>
      </div>
    )
  }

  <!-- password lock -->
  {
    entry.data.password && (
      <div
        class="hero-card-lock absolute top-2 right-2 z-30 flex items-center justify-center size-6 rounded-full bg-black/40 backdrop-blur-sm text-white"
        aria-label="加密"
      >
        <Icon name="material-symbols:lock-outline" class="text-base" />
      </div>
    )
  }
</div>


<style is:global>
  /* =============================================================
   * Hero 文章卡片（参考 ThriveX-Blog ArticleLayout/Classics）：
   * 封面图统一在右侧（内嵌圆角）+ 文字区落在半透明卡片底色上
   * ============================================================= */
  .post-card-wrapper.hero-card {
    height: 160px;
    background: var(--card-bg-transparent);
    position: relative;
  }

  /* hero 卡片阴影与全站 .card-base 静置投影一致 */
  .post-card-wrapper.hero-card.card-base {
    background: var(--card-bg-transparent) !important;
    border-color: transparent !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 4px 16px -6px rgba(0, 0, 0, 0.08) !important;
  }
  /* 深色模式沿用全站约定：深色背景上阴影不可读，保持无阴影 */
  :root.dark .post-card-wrapper.hero-card.card-base {
    box-shadow: none !important;
  }

  /* 底色由深色实心改为半透明卡片色后，原先硬编码的白字会看不见，
     这里统一改用随主题走的字色变量。 */
  .hero-card-title {
    color: var(--juejin-text-primary);
  }
  .hero-card-desc,
  .hero-card-meta-item,
  .hero-card-tag {
    color: var(--juejin-text-secondary);
  }
  .hero-card-meta-icon {
    color: var(--juejin-text-secondary);
    opacity: 0.75;
  }
  .hero-card-meta-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.375rem;
    background: var(--btn-regular-bg);
  }
  a.hero-card-meta-item:hover,
  a.hero-card-tag:hover {
    color: var(--primary);
  }

  @media (min-width: 768px) {
    .post-card-wrapper.hero-card {
      height: 13rem;
    }
  }
  @media (min-width: 1024px) {
    .post-card-wrapper.hero-card {
      height: 11rem;
    }
  }
  @media (min-width: 1280px) {
    .post-card-wrapper.hero-card {
      height: 13rem;
    }
  }

  .hero-card-side-img,
  .hero-card-side-img img {
    display: block;
  }

  .hero-card-side-img img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .hero-card-title:hover {
    color: var(--primary) !important;
  }

  /* grid-mode 下：覆盖旧规则强加的 1:1 方形、column-reverse 与固定行方向（固定高度已保证等高） */
  #post-list-container.grid-mode .post-card-wrapper.hero-card,
  #post-list-container.grid-mode .post-card-wrapper.hero-card.has-cover {
    aspect-ratio: auto !important;
    flex-direction: row !important;
    height: 160px !important;
  }
  @media (min-width: 768px) {
    #post-list-container.grid-mode .post-card-wrapper.hero-card,
    #post-list-container.grid-mode .post-card-wrapper.hero-card.has-cover {
      height: 13rem !important;
    }
  }

  /* 覆盖旧 list-mode 规则：不再降级为紧凑白色行 */
  @media (min-width: 768px) {
    #post-list-container.list-mode .post-card-wrapper.hero-card {
      background: var(--card-bg-transparent) !important;
      border: none !important;
      border-bottom: none !important;
      border-radius: var(--radius-large) !important;
      flex-direction: row !important;
      height: 13rem !important;
    }
    :root.dark #post-list-container.list-mode .post-card-wrapper.hero-card {
      border-bottom: none !important;
    }
    #post-list-container.list-mode .post-card-wrapper.hero-card:last-child {
      border-bottom: none !important;
    }
  }

  /* 覆盖旧"单一大白卡+紧贴行"外壳：hero 卡片之间恢复正常间距 */
  #post-list-container.list-mode:has(.hero-card) {
    gap: 1rem !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
  @media (min-width: 768px) {
    #post-list-container.list-mode:has(.hero-card) {
      gap: 1rem !important;
    }
  }
</style>
