---
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
	body: string;
}

const { title, body } = Astro.props;
---

<div class="mb-6 onload-animation">
	<div
		class="home-top-notice home-top-notice--pill post-outdated-notice relative grid w-full items-stretch overflow-hidden rounded-lg bg-(--card-bg) border border-black/[0.06] dark:border-white/10 shadow-sm px-3.5 py-2 sm:px-4 sm:py-2.5"
		role="note"
	>
		<div class="home-top-notice-row is-active flex w-full items-center gap-2.5">
			<span class="notice-label shrink-0 font-bold text-(--primary) text-[14.5px] sm:text-[15px]">
				{title}
			</span>
			<span
				class="notice-divider shrink-0 text-neutral-300 dark:text-neutral-600"
				aria-hidden="true"
			>
				|
			</span>
			<span class="notice-content-inline min-w-0 flex-1 dark:text-neutral-400 text-[14px] sm:text-[14.5px]">
				{body}
			</span>
		</div>
	</div>
</div>
