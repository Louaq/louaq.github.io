---
import { Icon } from "astro-icon/components";
import { homeTopNoticeConfig } from "@/config/homeTopNoticeConfig";
import type { HomeTopNoticeItem } from "@/types/config";

interface Props {
	items: HomeTopNoticeItem[];
}

const { items } = Astro.props;

// 轮播间隔（毫秒）：配置缺省或非法时回退到 8 秒，并且不低于一次淡入淡出的时长
const DEFAULT_SWITCH_INTERVAL = 8000;
const configuredInterval = homeTopNoticeConfig.switchInterval;
const switchInterval =
	typeof configuredInterval === "number" && configuredInterval >= 1000
		? configuredInterval
		: DEFAULT_SWITCH_INTERVAL;
---

<div class="home-top-notice-stack mt-3 mb-3">
	<div
		class="home-top-notice home-top-notice--pill relative grid w-full items-stretch overflow-hidden rounded-lg bg-(--card-bg) border border-black/[0.06] dark:border-white/10 shadow-sm px-3.5 py-2 sm:px-4 sm:py-2.5 transition-shadow duration-300 has-[a.home-top-notice-row:hover]:shadow-md"
		data-home-top-notice
		data-switch-interval={switchInterval}
	>
		{
			items.map((item, i) => {
				const hasLink = Boolean(item.link?.enable && item.link?.url?.trim());
				const rowClass = [
					"home-top-notice-row group flex w-full items-center gap-2.5",
					i === 0 && "is-active",
				];
				const inner = (
					<Fragment>
						{item.title && (
							<span class="notice-label shrink-0 font-bold text-(--primary) text-[14.5px] sm:text-[15px]">
								{item.title}
							</span>
						)}
						{item.title && (
							<span
								class="notice-divider shrink-0 text-neutral-300 dark:text-neutral-600"
								aria-hidden="true"
							>
								|
							</span>
						)}
						<span
							class="notice-content-inline min-w-0 flex-1 truncate dark:text-neutral-400 text-[14px] sm:text-[14.5px]"
							set:html={item.content}
						/>
						<Icon
							name="fa6-solid:chevron-right"
							class="notice-chevron shrink-0 size-3 text-neutral-300 dark:text-neutral-600 transition-transform duration-300 group-hover:translate-x-0.5"
							aria-hidden="true"
						/>
					</Fragment>
				);
				return hasLink ? (
					<a
						href={item.link!.url}
						target={item.link!.external ? "_blank" : "_self"}
						rel={item.link!.external ? "noopener noreferrer" : undefined}
						class:list={rowClass}
						data-notice-row={i}
						aria-hidden={i === 0 ? undefined : "true"}
						tabindex={i === 0 ? undefined : -1}
					>
						{inner}
					</a>
				) : (
					<div
						role="region"
						aria-label={item.title || "站点通知"}
						class:list={rowClass}
						data-notice-row={i}
						aria-hidden={i === 0 ? undefined : "true"}
					>
						{inner}
					</div>
				);
			})
		}
	</div>
</div>

<script>
	function pruneLegacyDismissKeys() {
		try {
			const prefix = "homeTopNoticeDismissed:";
			const removable: string[] = [];
			for (let i = 0; i < localStorage.length; i++) {
				const k = localStorage.key(i);
				if (k && k.startsWith(prefix)) removable.push(k);
			}
			for (const k of removable) localStorage.removeItem(k);
		} catch (_e) {
			// localStorage 不可用时静默忽略
		}
	}

	const noticeCycleTimers = new WeakMap<HTMLElement, number>();

	function initHomeTopNoticeCycle() {
		const containers = document.querySelectorAll<HTMLElement>(
			"[data-home-top-notice]"
		);

		for (const container of containers) {
			const prevTimer = noticeCycleTimers.get(container);
			if (prevTimer) window.clearInterval(prevTimer);

			const rows = Array.from(
				container.querySelectorAll<HTMLElement>("[data-notice-row]")
			);
			if (rows.length <= 1) continue;

			let activeIndex = Math.max(
				rows.findIndex((row) => row.classList.contains("is-active")),
				0
			);

			const parsedInterval = Number(container.dataset.switchInterval);
			const interval =
				Number.isFinite(parsedInterval) && parsedInterval >= 1000
					? parsedInterval
					: 8000;

			const timer = window.setInterval(() => {
				const nextIndex = (activeIndex + 1) % rows.length;
				const current = rows[activeIndex];
				const next = rows[nextIndex];

				current.classList.remove("is-active");
				current.setAttribute("aria-hidden", "true");
				if (current.tagName === "A") current.setAttribute("tabindex", "-1");

				next.classList.add("is-active");
				next.removeAttribute("aria-hidden");
				next.removeAttribute("tabindex");

				activeIndex = nextIndex;
			}, interval);

			noticeCycleTimers.set(container, timer);
		}
	}

	function setupHomeTopNotice() {
		pruneLegacyDismissKeys();
		initHomeTopNoticeCycle();
	}

	// 本脚本被 Astro 打包为 type="module"（defer），执行时 DOM 已解析完毕，
	// 首屏直接调用即可；swup 导航不会重新执行脚本，靠 astro:page-load 续上。
	// 原先监听的 swup:contentReplaced 是 swup 3 的事件名，本项目是 swup 4
	// （hook 名为 content:replace），该监听从不触发，导航后公告轮播不会重启。
	setupHomeTopNotice();
	document.addEventListener("astro:page-load", setupHomeTopNotice);
</script>

<style is:global>
	/* content 支持 HTML（如 <a href>）；样式与通知条文案色一致 */
	.notice-content-inline a {
		color: inherit;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.18em;
		text-decoration-thickness: min(2px, 0.1em);
	}
	.notice-content-inline a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
		border-radius: 2px;
	}

	/* 多条通知堆叠于同一格并循环淡入淡出切换 */
	.home-top-notice-row {
		grid-area: 1 / 1;
		opacity: 0;
		transform: translateY(6px);
		pointer-events: none;
		transition:
			opacity 0.5s ease,
			transform 0.5s ease;
	}
	.home-top-notice-row.is-active {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}
	@media (prefers-reduced-motion: reduce) {
		.home-top-notice-row {
			transition: none;
		}
	}
</style>
