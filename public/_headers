# Astro 构建产物：内容寻址，安全长缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 字体文件：长缓存（含 _astro 之外的 woff2/woff）
# 分片 woff2 是内容哈希文件名（cn-font-split 产出），改字体必然换名，可安全 immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# 分片字体的样式表：文件名固定不带哈希，重新切片后内容会变，
# 必须允许重新校验，否则客户端会一直指向已经不存在的旧分片
/font/lxgw/result.css
  Cache-Control: public, max-age=3600, must-revalidate

# public/assets 下的图片/JS：30 天
/assets/*
  Cache-Control: public, max-age=2592000

# HTML：始终重新校验，确保更新可见
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 全站安全头（对齐 vercel.json）
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
